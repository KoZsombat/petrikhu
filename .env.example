# Másold .env néven, és töltsd ki, mielőtt a saját gépeden kívül futtatod
# a `docker compose up`-ot (lásd docker-compose.yml, server/config.ts).
# A compose adja át a változókat a konténernek; `npm run server` a .env-et maga tölti be.

# A PostgreSQL jelszava (compose-ban a DATABASE_URL ebből áll össze).
POSTGRES_PASSWORD=change-me
# Compose nélkül (npm run server) közvetlenül a kapcsolati cím:
# DATABASE_URL=postgres://petrik:change-me@localhost:5432/petrik

# A bejelentkezési sütiket írja alá. Generálj egyet:  openssl rand -hex 32
PNW_SESSION_SECRET=change-me-to-a-long-random-string

# A három induló fiók (mk.vezeto, helyettes, igazgato) jelszava - csak üres
# adatbázisnál számít, vagyis egy friss szerveren. Legalább 8 karakter.
PNW_SEED_PASSWORD=

# Az egyetlen port, amin az API és az oldal is fut (alapból 4000).
# PNW_PORT=4000

# Cloudflare Tunnel: az oldal nyilvános címe (engedélyezett eredet a módosító hívásokhoz) és a tunnel tokenje
# (`docker compose --profile tunnel up`). A tunnel Public Hostname-je: http://petrik:4000
PNW_PUBLIC_URL=
TUNNEL_TOKEN=

# Hány proxy áll a szerver előtt (cloudflared: 1). Élesben alapból 1.
# PNW_TRUST_PROXY=1

# Opcionális: további eredetek, ahonnan módosító API-hívás érkezhet (vesszővel elválasztva)
PNW_ALLOWED_ORIGINS=

# Copy to .env and fill in before `docker compose up` (see docker-compose.yml). The API reads these in
# apps/server/src/config.ts; the public site reads PNW_API_URL and PNW_PUBLIC_URL.

# PostgreSQL password (compose builds DATABASE_URL from it) and database name (default petrik).
POSTGRES_PASSWORD=change-me
# PNW_DB_NAME=petrik
# Without compose (bun run dev), the connection string directly:
# DATABASE_URL=postgres://petrik:change-me@localhost:5432/petrik

# Signs the session cookies; at least 32 characters. Generate one:  openssl rand -hex 32
PNW_SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars

# Production: the initial password of the single admin account created on an empty database, and the replacement
# for any demo password still in use when the server starts. At least 10 characters (the server refuses to start
# otherwise). Either way the account must choose a new password at its first login. In development and tests an
# empty database gets the demo accounts instead (with this password, if set).
PNW_SEED_PASSWORD=
# Username of that first production admin (default: admin).
# PNW_ADMIN_USERNAME=admin

# The single exposed port (the Next.js site) on 127.0.0.1. Default 4000.
# PNW_PORT=4000

# The site's public address, e.g. https://petrik.hu: metadata URLs, Secure cookies, allowed origin of modifying calls.
PNW_PUBLIC_URL=
# Further origins allowed to send modifying API calls (comma-separated).
PNW_ALLOWED_ORIGINS=
# Where the API reads the visitor's IP (the key of every rate limit). docker-compose.yml defaults to
# cf-connecting-ip: Cloudflare sets and overwrites it, and Next.js passes it on. Only name a header that the proxy
# at the edge always overwrites. Empty (the default outside compose): the socket peer address.
# PNW_CLIENT_IP_HEADER=cf-connecting-ip
# (The web service reads it too, to pass the visitor's IP on with searches.)
# Opt-in instead of the header: the number of proxies in front of the API that each APPEND to X-Forwarded-For
# (the Next.js rewrite proxy does not). 0 = off (default). The left-most entry is never trusted on its own.
# PNW_TRUST_PROXY=0
# Whether the login card lists the demo accounts (default: on outside production).
# PNW_SHOW_DEMO_LOGINS=false

# Shared secret of the API and the site: after a change the API asks the site (POST /revalidate) to refresh its
# data cache. Without it the site still updates, but only within a minute. Generate one:  openssl rand -hex 32
PNW_REVALIDATE_SECRET=
# Where the API reaches the site for that (compose sets http://web:4000; default http://localhost:4000).
# PNW_SITE_URL=http://localhost:4000

# Cloudflare Tunnel token (`docker compose --profile tunnel up`); its Public Hostname: http://web:4000
TUNNEL_TOKEN=

# Backups (compose `backup` service, scripts/backup.sh): where, how long, when (UTC).
# PNW_BACKUP_DIR=./backups
# PNW_BACKUP_KEEP_DAYS=14
# PNW_BACKUP_AT=03:30

# Only for the one-off migration from the old app (bun run migrate:legacy):
# LEGACY_DATABASE_URL=postgres://petrik:change-me@localhost:5432/petrik_old

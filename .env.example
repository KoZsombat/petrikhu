# Copy this to .env and fill it in before running it anywhere other than your own machine
# `docker compose up` (see docker-compose.yml, server/config.ts).
# Compose passes the variables to the container; `npm run server` loads .env itself.

# The PostgreSQL password (under compose, DATABASE_URL is built from it).
POSTGRES_PASSWORD=change-me
# Without compose (npm run server), the connection string directly:
# DATABASE_URL=postgres://petrik:change-me@localhost:5432/petrik

# Signs the login cookies. Generate one:  openssl rand -hex 32
PNW_SESSION_SECRET=change-me-to-a-long-random-string

# Password of the three starting accounts (mk.vezeto, helyettes, igazgato) - only
# matters on an empty database, i.e. a fresh server. At least 8 characters.
PNW_SEED_PASSWORD=

# The only port the API and the site run on (default 4000).
# PNW_PORT=4000

# Cloudflare Tunnel: the site's public address (allowed origin for modifying calls) and the tunnel token
# (`docker compose --profile tunnel up`). A tunnel Public Hostname-je: http://petrik:4000
PNW_PUBLIC_URL=
TUNNEL_TOKEN=

# How many proxies sit in front of the server (cloudflared: 1). Defaults to 1 in production.
# PNW_TRUST_PROXY=1

# Optional: further origins that may send modifying API calls (comma-separated)
PNW_ALLOWED_ORIGINS=

# Test mode (e.g. a training instance): approval does not publish, it only sets the status "Tesztben jóváhagyva" (approved in test).
# PNW_TEST_MODE=false

# Backups (compose `backup` service, scripts/backup.sh): where, how long, when (UTC).
# PNW_BACKUP_DIR=./backups
# PNW_BACKUP_KEEP_DAYS=14
# PNW_BACKUP_AT=03:30

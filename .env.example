# One shared environment file for local development and Docker Compose.
# Copy to .env and adjust secrets before deploying.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app

# ---------------------------------------------------------------------------
# API (better-auth + Hono)
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3002,http://localhost:3003

# Seeded, non-removable admin account
ADMIN_EMAIL=admin@petrik.hu
ADMIN_PASSWORD=PetrikAdmin2026!
ADMIN_RESET_PASSWORD=false

# Optional mirror used by the idempotent legacy media seed
LEGACY_MEDIA_BASE_URL=https://petrik.hu

# ---------------------------------------------------------------------------
# Admin (Vite) — exposed to the browser, so the VITE_ prefix is required
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_WEB_URL=http://localhost:4321

# ---------------------------------------------------------------------------
# Public site (Astro)
# ---------------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:4321

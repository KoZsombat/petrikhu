---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  heading?: string;
  columns: string[];
  rows: { cells: string[] }[];
  footnote?: string;
  limit?: number;
}

const { heading, columns, rows, footnote, limit } = Astro.props;
const shown = limit === undefined ? rows : rows.slice(0, Math.max(0, limit));
---

<section data-component="table">
  <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-10">
    {heading && <div class="mb-6"><SectionHeading title={heading} /></div>}
    <div class="overflow-hidden rounded-xl border border-petrikline bg-petrikcard">
      <table class="block w-full border-collapse text-[15px] md:table">
        <thead class="hidden md:table-header-group">
          <tr class="bg-petriktint text-left">
            {
              columns.map((column) => (
                <th class="px-5 py-3.5 font-body text-[11px] font-semibold uppercase tracking-[0.12em] text-petrikaccentdark">
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody class="block md:table-row-group">
          {
            shown.map((row) => (
              <tr class="block border-t border-petriklinesoft first:border-t-0 md:table-row md:even:bg-petrikcream/60">
                {columns.map((column, c) => (
                  <td
                    data-label={column}
                    class:list={[
                      "block whitespace-pre-line px-5 py-2 align-top leading-snug before:mb-0.5 before:block before:font-body before:text-[10px] before:font-semibold before:uppercase before:tracking-[0.12em] before:text-petrikfaint before:content-[attr(data-label)] md:table-cell md:py-4 md:before:hidden",
                      c === 0 && "font-semibold text-petrikaccentdark",
                    ]}
                  >
                    {row.cells[c] ?? ""}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {footnote && <p class="mt-3 text-sm text-petriksoft">{footnote}</p>}
  </div>
</section>

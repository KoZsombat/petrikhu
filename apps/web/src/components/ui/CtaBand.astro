---
import Container from "./Container.astro";

interface Props {
  title: string;
  buttonLabel: string;
  href: string;
}

const { title, buttonLabel, href } = Astro.props;
---

<section data-component="cta" class="bg-petrikbg ">
  <Container class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <h2 class="font-display text-2xl font-bold leading-snug text-balance">{title}</h2>
    <a
      href={href}
      class="inline-block shrink-0 rounded-md bg-petrikaccent px-5 py-[11px] text-[15px] font-semibold text-petrikcard hover:bg-petrikaccentdark"
    >
      {buttonLabel}
    </a>
  </Container>
</section>

---
import DateTag from "../ui/DateTag.astro";
import type { NewsRowData } from "../../lib/news";

interface Props {
  item: NewsRowData;
  detailsLabel?: string;
}

const { item, detailsLabel = "Részletek →" } = Astro.props;
---

<article class="flex flex-col overflow-hidden rounded-xl border border-black/5 bg-petrikcard shadow-sm">
  <div class="relative h-44 border-b-4 border-petrikaccent">
    <img
      src={item.image?.src ?? "/img/hero-640.webp"}
      alt={item.image?.alt ?? ""}
      loading="lazy"
      class="size-full object-cover"
    />
    <span class="absolute left-4 top-4">
      <DateTag date={item.date} />
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="font-display text-lg font-semibold text-petrikink">{item.title}</h3>
    <p class="line-clamp-3 flex-1 font-body text-[15px] leading-relaxed text-petriksoft">
      {item.excerpt}
    </p>
    <a
      href={item.href}
      class="mt-4 text-xs font-semibold uppercase tracking-wider text-petrikaccentdark"
    >
      {detailsLabel}
    </a>
  </div>
</article>

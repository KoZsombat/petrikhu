---
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  class?: string;
}

const { title, eyebrow, intro, class: className = "" } = Astro.props;
---

<div class:list={["mb-6", className]}>
  {eyebrow && <p class="petrik-eyebrow mb-2">{eyebrow}</p>}
  <h2 class="font-display text-2xl font-semibold tracking-[-0.015em] text-balance">{title}</h2>
  {intro && <p class="mt-3 max-w-[64ch] text-[15px] leading-relaxed text-petriksoft">{intro}</p>}
</div>

---
/**
 * Rich text of a page block. The HTML is static content of this repository (never user input),
 * so it is injected as-is; links and markup follow the old site's content.
 */
interface Props {
  html: string;
  variant?: "default" | "bare" | "post";
  class?: string;
  embedTitle?: string;
}

const { html, variant = "default", class: className = "", embedTitle = "Beágyazott tartalom" } = Astro.props;

const variantClass = {
  default: "",
  bare: "text-[15.5px] leading-relaxed [&_p+p]:mt-3",
  post: "text-[17.5px] leading-[1.75]",
}[variant];
---

<div
  class:list={["petrik-prose", variantClass, className]}
  data-component="richText"
  title={embedTitle}
  set:html={html}
/>

---
import Container from "./Container.astro";
import { youtubeId } from "../../lib/format";

interface Item {
  heading: string;
  url: string;
  title?: string;
  caption?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section data-component="videoGrid">
  <Container>
    <div class="grid gap-6 md:grid-cols-2">
      {
        items.map((item) => {
          const id = youtubeId(item.url);
          return (
            <article>
              <h2 class="mb-4 font-display text-2xl font-bold text-balance">{item.heading}</h2>
              {id ? (
                <div class="aspect-video overflow-hidden rounded-xl bg-petrikink">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${id}`}
                    title={item.title ?? item.heading}
                    loading="lazy"
                    allowfullscreen
                    class="size-full border-0"
                  />
                </div>
              ) : (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-petrikaccentdark underline">
                  ▶ {item.title ?? item.url}
                </a>
              )}
              {item.caption && <p class="mt-3 text-sm text-petriksoft">{item.caption}</p>}
            </article>
          );
        })
      }
    </div>
  </Container>
</section>

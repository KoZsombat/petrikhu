---
import Prose from "./Prose.astro";
import SectionHeading from "./SectionHeading.astro";

interface Item {
  title: string;
  html: string;
}

interface Props {
  heading?: string;
  items: Item[];
  openFirst?: boolean;
  class?: string;
  id?: string;
}

const { heading, items, openFirst = false, class: className = "", id } = Astro.props;
---

<section data-component="accordion" id={id} class:list={["scroll-mt-32", className]}>
  <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-10">
    {heading && <div class="mb-6"><SectionHeading title={heading} /></div>}
    <div class="divide-y divide-petriklinesoft overflow-hidden rounded-xl border border-petrikline bg-petrikcard">
      {
        items.map((item, i) => (
          <details open={openFirst && i === 0} class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-lg font-semibold hover:bg-petriktint [&::-webkit-details-marker]:hidden">
              {item.title}
              <span
                aria-hidden="true"
                class="flex size-7 shrink-0 items-center justify-center rounded-full bg-petriktint text-petrikaccentdark transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <div
              data-accordion-panel
              class="overflow-hidden opacity-0 transition-[height,opacity] duration-300 ease-out motion-reduce:transition-none"
            >
              <div class="px-5 pb-5">
                <Prose html={item.html} variant="bare" />
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const details of document.querySelectorAll<HTMLDetailsElement>('[data-component="accordion"] details')) {
    const summary = details.querySelector("summary");
    const panel = details.querySelector<HTMLElement>("[data-accordion-panel]");
    if (!summary || !panel || reduceMotion) continue;

    panel.style.height = details.open ? "auto" : "0px";
    panel.style.opacity = details.open ? "1" : "0";

    summary.addEventListener("click", (event) => {
      event.preventDefault();
      if (details.dataset.animating === "true") return;

      if (details.open) {
        const height = panel.getBoundingClientRect().height;
        panel.style.height = `${height}px`;
        panel.style.opacity = "1";
        details.dataset.animating = "true";

        requestAnimationFrame(() => {
          panel.style.height = "0px";
          panel.style.opacity = "0";
        });

        window.setTimeout(() => {
          details.open = false;
          panel.style.height = "0px";
          panel.style.opacity = "0";
          details.dataset.animating = "false";
        }, 320);
      } else {
        details.open = true;
        panel.style.height = "0px";
        panel.style.opacity = "0";
        details.dataset.animating = "true";

        requestAnimationFrame(() => {
          panel.style.height = `${panel.scrollHeight}px`;
          panel.style.opacity = "1";
        });

        window.setTimeout(() => {
          panel.style.height = "auto";
          details.dataset.animating = "false";
        }, 320);
      }
    });
  }
</script>

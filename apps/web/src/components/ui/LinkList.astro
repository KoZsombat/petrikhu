---
import SectionHeading from "./SectionHeading.astro";

interface Item {
  title: string;
  meta?: string;
  href?: string;
}

interface Props {
  heading?: string;
  items: Item[];
  limit?: number;
}

const { heading, items, limit } = Astro.props;
const shown = limit === undefined ? items : items.slice(0, Math.max(0, limit));
---

<section data-component="linkList" class=" ">
  <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-10">
    {heading && <div class="mb-6"><SectionHeading title={heading} /></div>}
    <ul class="grid gap-3 md:grid-cols-2">
      {
        shown.map((item) => (
          <li>
            {item.href ? (
              <a
                href={item.href}
                class="group flex items-center justify-between gap-4 rounded-xl border border-petrikline bg-petrikcard px-5 py-4 transition-colors hover:border-petrikaccent hover:bg-petriktint"
              >
                <span>
                  <span class="block font-semibold leading-snug">{item.title}</span>
                  {item.meta && <span class="mt-0.5 block text-sm text-petriksoft">{item.meta}</span>}
                </span>
                <span aria-hidden="true" class="text-petrikaccentdark transition-transform group-hover:translate-x-1">
                  →
                </span>
              </a>
            ) : (
              <div class="flex items-center gap-3 rounded-xl border border-petrikline bg-petrikcard px-5 py-4">
                <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-petrikaccent"></span>
                <span>
                  <span class="block font-semibold leading-snug">{item.title}</span>
                  {item.meta && <span class="mt-0.5 block text-sm text-petriksoft">{item.meta}</span>}
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

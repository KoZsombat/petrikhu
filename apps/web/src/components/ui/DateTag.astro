---
interface Props {
  date: string;
  class?: string;
}

const { date, class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-block rounded-sm bg-petrikaccent px-2 py-1 font-body text-[11px] font-semibold uppercase leading-none tracking-[0.04em] tabular-nums text-petrikcard",
    className,
  ]}
>
  {date}
</span>

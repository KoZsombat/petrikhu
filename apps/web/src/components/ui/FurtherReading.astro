---
import { ArrowUpRight, BookOpen } from "lucide-react";
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";

interface Item {
  title: string;
  meta?: string;
  href?: string;
}

interface Props {
  heading?: string;
  intro?: string;
  items: Item[];
}

const { heading = "További olvasnivaló", intro, items } = Astro.props;
---

<section data-component="furtherReading" class=" ">
  <Container class="grid gap-8 md:grid-cols-[300px_minmax(0,1fr)] md:items-start">
    <SectionHeading title={heading} eyebrow="Kapcsolódó" intro={intro} />
    <ul class="grid gap-3">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              target={item.href?.startsWith("http") ? "_blank" : undefined}
              rel={item.href?.startsWith("http") ? "noreferrer" : undefined}
              class="group flex items-start gap-4 rounded-xl border border-petrikline bg-petrikcard p-6 transition duration-200 hover:-translate-y-0.5 hover:border-petrikaccent/50 hover:shadow-[0_18px_40px_-32px_rgba(22,33,29,0.55)] motion-reduce:transform-none"
            >
              <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-petriktint text-petrikaccentdark">
                <BookOpen className="size-5" aria-hidden />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-display text-[19px] font-semibold leading-snug text-balance">
                  {item.title}
                </span>
                {item.meta && (
                  <span class="mt-2 block font-mono text-[10.5px] uppercase tracking-[0.08em] text-petrikfaint">
                    {item.meta}
                  </span>
                )}
              </span>
              <ArrowUpRight className="mt-1 size-5 shrink-0 text-petrikfaint transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-petrikaccentdark motion-reduce:transform-none" aria-hidden />
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

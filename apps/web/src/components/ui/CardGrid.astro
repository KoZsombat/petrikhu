---
import Container from "./Container.astro";
import DateTag from "./DateTag.astro";

export type TextItem = {
  title: string;
  text?: string;
  eyebrow?: string;
  date?: string;
  href?: string;
  linkLabel?: string;
};

export type PersonItem = {
  name: string;
  role?: string;
  room?: string;
  phone?: string;
  email?: string;
  photo?: string;
};

type Props =
  | { variant: "text"; items: TextItem[]; columns?: 2 | 3 | 4; heading?: string; limit?: number }
  | { variant: "person"; items: PersonItem[]; columns?: 2 | 3 | 4; heading?: string; limit?: number };

const props = Astro.props as Props;

/* Full class names are written out so Tailwind can detect them. */
const COLUMNS: Record<2 | 3 | 4, string> = {
  2: "grid-cols-1 sm:grid-cols-2",
  3: "grid-cols-1 sm:grid-cols-2 md:grid-cols-3",
  4: "grid-cols-1 sm:grid-cols-2 md:grid-cols-4",
};

const CARD = "relative rounded-xl border border-petrikline bg-petrikcard";
const STRETCH = "after:absolute after:inset-0 after:content-['']";
const CARD_FOCUS =
  "has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-petrikaccent";

const items = props.limit === undefined ? props.items : props.items.slice(0, Math.max(0, props.limit));
const detailLabel = "RÉSZLETEK →";

---

<section data-component="cards" data-variant={props.variant}>
  <Container>
    {props.heading && (
      <h2 class="mb-6 font-display text-2xl font-semibold tracking-[-0.015em] text-balance">{props.heading}</h2>
    )}
    <ul class:list={["grid gap-4", COLUMNS[props.columns ?? 3]]}>
      {
        props.variant === "text" &&
          (items as TextItem[]).map((item) => (
            <li class="flex">
              <article
                class:list={[
                  CARD,
                  "flex w-full flex-col items-start p-[22px]",
                  Boolean(item.href) && "motion-safe:transition-shadow hover:shadow-md",
                  Boolean(item.href) && CARD_FOCUS,
                ]}
              >
                {item.date && (
                  <div class="mb-3">
                    <DateTag date={item.date} />
                  </div>
                )}
                {item.eyebrow && <p class="petrik-eyebrow mb-2">{item.eyebrow}</p>}
                <h3 class="font-display text-[17px] font-semibold leading-snug">{item.title}</h3>
                {item.text && <p class="mt-2 whitespace-pre-line text-sm leading-[1.55] text-petriksoft">{item.text}</p>}
                {item.href && (
                  <a
                    href={item.href}
                    class:list={[
                      "petrik-eyebrow mt-auto pt-4 font-medium hover:underline",
                      STRETCH,
                    ]}
                  >
                    {item.linkLabel ?? detailLabel}
                  </a>
                )}
              </article>
            </li>
          ))
      }
      {
        props.variant === "person" &&
          (items as PersonItem[]).map((item) => (
            <li class="flex">
              <article class:list={[CARD, "flex w-full items-start gap-4 p-[22px]"]}>
                <img
                  src={item.photo ?? "/img/teacher-placeholder.png"}
                  alt={`${item.name} fényképe`}
                  loading="lazy"
                  class="size-12 shrink-0 rounded-full bg-petriktint object-cover"
                />
                <div class="min-w-0">
                  <h3 class="font-body text-base font-semibold leading-snug">{item.name}</h3>
                  {item.role && <p class="petrik-eyebrow mt-1">{item.role}</p>}
                  <div class="mt-2 space-y-0.5 text-[13px] leading-normal text-petriksoft">
                    {item.room && <p class="whitespace-pre-line">{item.room}</p>}
                    {item.phone && (
                      <p>
                        <a href={`tel:${item.phone.replace(/[^\d+]/g, "")}`} class="hover:underline">
                          {item.phone}
                        </a>
                      </p>
                    )}
                    {item.email && (
                      <p class="break-words">
                        <a href={`mailto:${item.email}`} class="hover:underline">
                          {item.email}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </article>
            </li>
          ))
      }
    </ul>
  </Container>
</section>

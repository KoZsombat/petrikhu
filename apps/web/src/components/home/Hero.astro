---
import { ArrowRight } from "lucide-react";
import type { SiteStats } from "../../lib/api";
import { TRANSLATIONS, translator, type Locale } from "../../lib/i18n";
import { localizedHref } from "../../lib/site";
import { yearsSinceFounding } from "../../lib/stats";

interface Props {
  locale: Locale;
  stats: SiteStats | null;
}

const { locale, stats } = Astro.props;
const t = translator(locale);

const years = yearsSinceFounding();
const roundedYears = Math.floor(years / 10) * 10;
const students = stats?.students ?? "—";

const STATS = [
  { value: years % 10 === 0 ? `${years}` : `${roundedYears}+`, label: t("home.statYears") },
  { value: students, label: t("home.statStudents") },
  { value: "~25%", label: t("home.statBilingual") },
];
---

<section data-component="hero" class="relative isolate w-full max-w-screen overflow-hidden bg-[#1B2420] text-petrikcream">
  <picture class="contents">
    <source
      type="image/avif"
      srcset="/img/hero-640.avif 640w, /img/hero-1280.avif 1280w, /img/hero-1920.avif 1920w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/img/hero-640.webp 640w, /img/hero-1280.webp 1280w, /img/hero-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src="/img/hero-1280.jpg"
      srcset="/img/hero-640.jpg 640w, /img/hero-1280.jpg 1280w, /img/hero-1920.jpg 1920w"
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>
  <div class="absolute inset-0 bg-[#0E1512]/75"></div>

  <canvas
    data-network-field
    data-logo="/icon-192.png"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full opacity-0 xl:inset-y-0 xl:left-auto xl:right-0 xl:h-full xl:w-[68%] xl:opacity-100"></canvas>

  <div
    class="relative z-10 mx-auto flex min-h-[38rem] w-full max-w-[1240px] flex-col justify-center px-5 py-12 sm:px-10 md:min-h-[44rem] md:w-[80%] md:max-w-none"
  >
    <p class="hero-fade font-body text-[10px] font-semibold uppercase tracking-[0.18em] text-petrikpale md:text-xs">
      {t("home.eyebrow")}
    </p>
    <h1
      data-hero-avoid
      class="hero-fade mt-4 max-w-3xl font-display text-3xl font-semibold leading-[1.05] tracking-[-0.02em] md:text-6xl"
      style="animation-delay: 0.06s"
    >
      {t("home.headline")}
    </h1>
    <p
      class="hero-fade mt-5 max-w-lg font-body text-sm leading-relaxed text-petrikcream/80 md:text-base"
      style="animation-delay: 0.12s"
    >
      {t("home.lead")}
    </p>
    <div class="hero-fade mt-7 flex flex-wrap items-center gap-x-6 gap-y-4" style="animation-delay: 0.18s">
      <a
        href={localizedHref(locale, "/nyolcadikos", TRANSLATIONS)}
        class="group inline-flex items-center gap-2 rounded-md bg-petrikaccent px-5 py-2.5 font-body text-sm font-semibold text-white transition-colors hover:bg-petrikaccentdark"
      >
        {t("nav.eighthGraders")}
        <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
      </a>
      <a
        href={localizedHref(locale, "/technikusi-kepzesek", TRANSLATIONS)}
        class="border-b border-petrikcream/35 pb-0.5 font-body text-sm font-semibold transition-colors hover:border-petrikcream hover:text-white"
      >
        {t("home.explore")}
      </a>
    </div>
    <dl
      class="hero-fade mt-10 grid max-w-2xl grid-cols-3 gap-4 border-t border-petrikcream/20 pt-5"
      style="animation-delay: 0.24s"
    >
      {
        STATS.map((stat) => (
          <div>
            <dd class="font-display text-2xl font-semibold tabular-nums md:text-4xl">{stat.value}</dd>
            <dt class="mt-1 font-body text-[11px] font-semibold uppercase tracking-[0.12em] text-petrikcream/75 md:text-xs">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
type IconName = "flask" | "leaf" | "code";

type Body = {
  orbiting: boolean;
  orbitIndex: number;
  a0: number;
  icon: IconName | null;
  r: number;
  phase: number;
  hx: number;
  hy: number;
  x: number;
  y: number;
  vx: number;
  vy: number;
};

const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const canvas = document.querySelector<HTMLCanvasElement>("[data-network-field]");
const ctx = canvas?.getContext("2d");

if (canvas && ctx) {
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

  const logo = new Image();
  let logoReady = false;
  logo.onload = () => {
    logoReady = true;
    if (reduceMotion) draw();
  };
  logo.src = canvas.dataset.logo ?? "/petrik-logo.png";

  // Icons in a -21..21 drawing box.
  const ICONS: Record<IconName, Path2D> = {
    flask: new Path2D("M-7 -20 H7 M-4.5 -20 V-5 L-17 15 Q-20 21 -13 21 H13 Q20 21 17 15 L4.5 -5 V-20 M-11 8 H11"),
    leaf: new Path2D("M-16 15 C-17 -9 -2 -19 16 -16 C18 2 8 16 -16 15 Z M-16 15 L6 -6"),
    code: new Path2D("M-10 -14 L-21 0 L-10 14 M10 -14 L21 0 L10 14 M3.5 -19 L-3.5 19"),
  };

  const HUB_DEFS = [
    { icon: "flask", a0: -Math.PI / 2 },
    { icon: "leaf", a0: Math.PI / 6 },
    { icon: "code", a0: (5 * Math.PI) / 6 },
  ] as const;

  let width = 0;
  let height = 0;
  let unit = 0;
  let cx = 0; // the logo, and the center of the orbit
  let cy = 0;
  let rx = 0; // orbit radii
  let ry = 0;
  let hubs: Body[] = [];
  let center: Body | null = null;
  let frame = 0;
  let running = true;
  const ENTRANCE_DURATION = 550;
  let entranceStartedAt: number | null = reduceMotion ? 0 : null;

  const ORBIT_SPEED = 0.16; // rad/s – one lap in about 40 s
  const BREATH = 0.035; // how far the subjects drift in and out (fraction of the radius)
  const ORBIT_SCALE = 0.8; // the complete orbit composition is 1.25x smaller
  const ORBIT_WIDTH_SCALE = 0.8; // make the orbit composition narrower horizontally
  const BODY_SCALE = 0.8; // the logo and planets are 1.25x smaller than the orbit fields
  const ORBIT_SPECS = [
    { scaleX: 0.82, scaleY: 0.56, angle: -0.28, offsetX: -0.08, offsetY: 0.02 },
    { scaleX: 1.04, scaleY: 0.48, angle: 0.14, offsetX: 0.05, offsetY: -0.06 },
    { scaleX: 0.94, scaleY: 0.68, angle: 0.42, offsetX: -0.03, offsetY: 0.05 },
  ];

  // Where a body wants to be at time t: hubs circle the logo and drift in and out.
  const targetOf = (h: Body, t: number): [number, number] => {
    if (!h.orbiting) return [cx, cy];
    const angle = h.a0 + t * ORBIT_SPEED;
    const breath = 1 + (reduceMotion ? 0 : Math.sin(t * 0.55 + h.phase) * BREATH);
    const spec = ORBIT_SPECS[h.orbitIndex] ?? ORBIT_SPECS[0]!;
    const px = Math.cos(angle) * rx * spec.scaleX * breath;
    const py = Math.sin(angle) * ry * spec.scaleY * breath;
    return [
      cx + rx * spec.offsetX + px * Math.cos(spec.angle) - py * Math.sin(spec.angle),
      cy + ry * spec.offsetY + px * Math.sin(spec.angle) + py * Math.cos(spec.angle),
    ];
  };

  const makeBody = (icon: IconName | null, r: number, phase: number, a0: number, orbiting: boolean, orbitIndex = 0): Body => {
    const body: Body = { icon, r, phase, a0, orbiting, orbitIndex, hx: 0, hy: 0, x: 0, y: 0, vx: 0, vy: 0 };
    const [x, y] = targetOf(body, 0);
    body.hx = body.x = x;
    body.hy = body.y = y;
    return body;
  };

  const resize = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    if (width === 0 || height === 0) return;
    unit = Math.min(width, height);
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const mobile = width < 768;
    let rightPadding = 0;
    if (mobile) {
      rx = clamp(Math.min(width * 0.42, height * 0.3), 96, 180);
      ry = rx * 0.75;
      cx = width * 0.5;
      cy = height * 0.30;
    } else {
      const sectionWidth = canvas.closest("section")?.clientWidth ?? width;
      const maxHub = 44;
      rightPadding = sectionWidth * 0.1;
      const maxOrbitRadius = Math.max(60, (width - rightPadding) / (2 * 1.09));
      rx = Math.max(60, Math.min(width / 2 - maxHub - 14, maxOrbitRadius));
      ry = Math.max(60, Math.min(height / 2 - maxHub - 44, rx * 1.05));
      cx = width - rightPadding - rx * 1.09;
      cy = height / 2;
    }

    rx *= ORBIT_SCALE * ORBIT_WIDTH_SCALE;
    ry *= ORBIT_SCALE;
    if (!mobile) cx = width - rightPadding - rx * 1.09;
    const rMin = Math.min(rx, ry) * (1 - BREATH);
    const hubR = (clamp(Math.min(unit * 0.07, rMin * 0.3), 22, 44) / 1.5) * BODY_SCALE;
    const logoR = (clamp(Math.min(unit * 0.12, rMin * 0.42), 36, 84) / 1.5) * BODY_SCALE;
    hubs = HUB_DEFS.map((d, i) => makeBody(d.icon, hubR, i * 2.1, d.a0, true, i));
    center = makeBody(null, logoR, 0, 0, false);
    if (!reduceMotion && entranceStartedAt === null) {
      center.x = center.hx = cx;
      center.y = center.hy = cy;
      for (const h of hubs) {
        h.x = h.hx = cx;
        h.y = h.hy = cy;
        h.vx = h.vy = 0;
      }
    }
    if (reduceMotion) draw();
  };

  const updateBody = (h: Body, t: number) => {
    const [tx, ty] = targetOf(h, t);
    h.hx = tx;
    h.hy = ty;
    h.vx += (tx - h.x) * 0.03;
    h.vy += (ty - h.y) * 0.03;
    h.vx *= 0.86;
    h.vy *= 0.86;
    h.x = clamp(h.x + h.vx, h.r, width - h.r);
    h.y = clamp(h.y + h.vy, h.r, height - h.r - 34);
  };

  const clamp01 = (v: number) => clamp(v, 0, 1);
  const easeOutCubic = (v: number) => 1 - Math.pow(1 - v, 3);

  const drawHub = (h: Body, t: number, entranceScale = 1, entranceAlpha = 1) => {
    const { x, y, r } = h;
    ctx.save();
    ctx.globalAlpha = entranceAlpha;
    ctx.translate(x, y);
    ctx.scale(entranceScale, entranceScale);
    ctx.translate(-x, -y);
    if (!reduceMotion) {
      for (let k = 0; k < 2; k++) {
        const p = (t / 3.6 + k * 0.5) % 1;
        ctx.strokeStyle = `rgba(177,210,88,${0.5 * (1 - p)})`;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(x, y, r * (1 + p * 0.9), 0, Math.PI * 2);
        ctx.stroke();
      }
    }
    ctx.shadowColor = "#2B8272";
    ctx.shadowBlur = 22;
    ctx.fillStyle = "rgba(5,18,20,0.93)";
    ctx.strokeStyle = "#2B8272";
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    ctx.shadowBlur = 0;

    ctx.setLineDash([2, 5]);
    ctx.strokeStyle = "rgba(133,193,182,0.35)";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(x, y, r - 6, 0, Math.PI * 2);
    ctx.stroke();
    ctx.setLineDash([]);

    if (h.icon) {
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(r / 42, r / 42);
      ctx.strokeStyle = "#E6FFF8";
      ctx.lineWidth = 2.6;
      ctx.lineCap = ctx.lineJoin = "round";
      ctx.stroke(ICONS[h.icon]);
      ctx.restore();
    }

    ctx.restore();
  };

  const drawCenter = (h: Body, t: number, entranceScale = 1, entranceAlpha = 1) => {
    const { x, y, r } = h;
    ctx.save();
    ctx.globalAlpha = entranceAlpha;
    ctx.translate(x, y);
    ctx.scale(entranceScale, entranceScale);
    ctx.translate(-x, -y);
    if (!reduceMotion) {
      for (let k = 0; k < 3; k++) {
        const p = (t / 4.5 + k / 3) % 1;
        ctx.strokeStyle = `rgba(133,193,182,${0.45 * (1 - p)})`;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(x, y, r * (1 + p * 0.7), 0, Math.PI * 2);
        ctx.stroke();
      }
    }
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(t * 0.12);
    ctx.setLineDash([3, 9]);
    ctx.strokeStyle = "rgba(177,210,88,0.6)";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(0, 0, r + 9, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
    ctx.setLineDash([]);

    ctx.shadowColor = "#85C1B6";
    ctx.shadowBlur = 30;
    ctx.fillStyle = "#2B8272";
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    if (logoReady) {
      ctx.save();
      ctx.beginPath();
      ctx.arc(x, y, r, 0, Math.PI * 2);
      ctx.clip();
      ctx.drawImage(logo, x - r, y - r, r * 2, r * 2);
      ctx.restore();
    }
    ctx.strokeStyle = "rgba(255,255,255,0.85)";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
  };

  const drawOrbitFields = (entranceProgress = 1) => {
    for (let i = 0; i < ORBIT_SPECS.length; i++) {
      const spec = ORBIT_SPECS[i]!;
      const delay = i * 0.07;
      const progress = easeOutCubic(clamp01((entranceProgress - delay) / (1 - delay)));
      if (progress <= 0) continue;
      ctx.save();
      ctx.globalAlpha = progress;
      ctx.translate(cx + rx * spec.offsetX, cy + ry * spec.offsetY);
      ctx.rotate(spec.angle);
      ctx.setLineDash([4, 7]);
      ctx.lineDashOffset = i * 3;
      ctx.lineWidth = 1;
      ctx.strokeStyle = "rgba(255,255,255,0.65)";
      ctx.beginPath();
      const fieldScale = 0.55 + progress * 0.45;
      ctx.ellipse(0, 0, rx * spec.scaleX * fieldScale, ry * spec.scaleY * fieldScale, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }
  };

  const draw = () => {
    if (!center || width === 0) return;
    const now = performance.now();
    const t = reduceMotion ? 0 : now / 1000;
    const entranceProgress = reduceMotion
      ? 1
      : entranceStartedAt === null
        ? 0
        : clamp01((now - entranceStartedAt) / ENTRANCE_DURATION);
    const orbitTime = reduceMotion || entranceStartedAt === null
      ? 0
      : Math.max(0, (now - entranceStartedAt - ENTRANCE_DURATION) / 1000);

    ctx.clearRect(0, 0, width, height); // transparent: the hero photo shows through

    if (!reduceMotion) {
      if (entranceProgress < 1) {
        center.x = center.hx = cx;
        center.y = center.hy = cy;
        center.vx = center.vy = 0;
        for (const h of hubs) {
          const [tx, ty] = targetOf(h, 0);
          const planetDelay = 0.18 + h.orbitIndex * 0.06;
          const planetProgress = easeOutCubic(clamp01((entranceProgress - planetDelay) / (1 - planetDelay)));
          h.x = h.hx = cx + (tx - cx) * planetProgress;
          h.y = h.hy = cy + (ty - cy) * planetProgress;
          h.vx = h.vy = 0;
        }
      } else {
        updateBody(center, orbitTime);
        for (const h of hubs) updateBody(h, orbitTime);
      }
    }

    drawOrbitFields(entranceProgress);

    for (const h of hubs) {
      const planetDelay = 0.18 + h.orbitIndex * 0.06;
      const planetProgress = easeOutCubic(clamp01((entranceProgress - planetDelay) / (1 - planetDelay)));
      drawHub(h, t, 0.4 + planetProgress * 0.6, planetProgress);
    }

    const logoProgress = clamp01(entranceProgress / 0.42);
    const logoScale = entranceProgress < 0.42
      ? 0.05 + easeOutCubic(logoProgress) * 1.13
      : 1.18 - easeOutCubic(clamp01((entranceProgress - 0.42) / 0.58)) * 0.18;
    const logoAlpha = clamp01(entranceProgress / 0.18);
    drawCenter(center, t, logoScale, logoAlpha);

    if (!reduceMotion && running) frame = requestAnimationFrame(draw);
  };

  new ResizeObserver(resize).observe(canvas);

  // Do not animate while the hero is off-screen (or hidden on small screens).
  new IntersectionObserver(([entry]) => {
    if (!entry) return;
    if (entry.isIntersecting) {
      if (entranceStartedAt === null) entranceStartedAt = performance.now();
      if (!running) {
        running = true;
        if (!reduceMotion) frame = requestAnimationFrame(draw);
      }
    } else if (!entry.isIntersecting) {
      running = false;
      cancelAnimationFrame(frame);
    }
  }).observe(canvas);

  resize();
  draw();

  window.addEventListener("pagehide", () => cancelAnimationFrame(frame));
}
</script>

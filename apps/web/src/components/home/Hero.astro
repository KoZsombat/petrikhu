---
import { ArrowRight } from "lucide-react";
import { TRANSLATIONS, translator, type Locale } from "../../lib/i18n";
import { localizedHref } from "../../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);

const words = t("home.headline").split(" ");

const STATS = [
  { value: 140, prefix: "", suffix: "+", label: t("home.statYears") },
  { value: 1200, prefix: "~", suffix: "", label: t("home.statStudents") },
  { value: 25, prefix: "~", suffix: "%", label: t("home.statBilingual") },
];
---

<section data-component="hero" class="relative isolate w-full max-w-screen overflow-hidden bg-[#1B2420] text-petrikcream">
  <picture class="contents">
    <source
      type="image/avif"
      srcset="/img/hero-640.avif 640w, /img/hero-1280.avif 1280w, /img/hero-1920.avif 1920w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/img/hero-640.webp 640w, /img/hero-1280.webp 1280w, /img/hero-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src="/img/hero-1280.jpg"
      srcset="/img/hero-640.jpg 640w, /img/hero-1280.jpg 1280w, /img/hero-1920.jpg 1920w"
      sizes="100vw"
      alt=""
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
  </picture>
  <div class="absolute inset-0 bg-black/60"></div>
  <div class="hero-glow absolute -left-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-petrikaccent/40 blur-[120px]"></div>
  <div
    class="hero-glow absolute -bottom-52 right-0 h-[30rem] w-[30rem] rounded-full bg-petriklight/20 blur-[130px] [animation-delay:-6s]"
  >
  </div>
  <canvas data-molecule-field aria-hidden="true" class="absolute inset-y-0 right-0 h-full w-full md:w-3/5"></canvas>
  <div class="hero-stripes pointer-events-none absolute inset-0"></div>

  <div
    class="relative z-10 mx-auto flex min-h-[40rem] w-full max-w-[1240px] flex-col justify-center px-5 py-10 sm:px-10 md:min-h-[46rem]"
  >
    <p
      class="hero-rise font-body text-[10px] font-semibold uppercase tracking-[0.18em] text-petrikpale md:text-xs"
      style="animation-delay: 0.1s"
    >
      {t("home.eyebrow")}
    </p>
    <h1 class="mt-4 max-w-3xl font-display text-3xl font-semibold leading-[1.03] tracking-[-0.025em] md:text-6xl">
      {
        words.map((word, i) => (
          <span class="mr-[0.25em] inline-block overflow-hidden align-bottom">
            <span class="hero-word inline-block" style={`animation-delay: ${0.25 + i * 0.09}s`}>
              {word}
            </span>
          </span>
        ))
      }
    </h1>
    <p
      class="hero-rise mt-5 max-w-lg font-body text-sm leading-relaxed text-petrikcream/80 md:text-base"
      style="animation-delay: 1s"
    >
      {t("home.lead")}
    </p>
    <div class="hero-rise mt-6 flex flex-wrap items-center gap-x-6 gap-y-4" style="animation-delay: 1.15s">
      <a
        href={localizedHref(locale, "/nyolcadikos", TRANSLATIONS)}
        class="group inline-flex items-center gap-3 rounded-full bg-petrikaccent px-6 py-3 font-body text-sm font-semibold text-white shadow-[0_0_40px_-4px_rgba(43,130,114,0.8)] transition hover:bg-petrikaccentdark"
      >
        {t("nav.eighthGraders")}
        <ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" />
      </a>
      <a
        href={localizedHref(locale, "/technikusi-kepzesek", TRANSLATIONS)}
        class="border-b-2 border-petrikcream/30 pb-0.5 font-body text-sm font-semibold transition hover:border-petriklight hover:text-petriklight"
      >
        {t("home.explore")}
      </a>
    </div>
    <dl
      class="hero-rise mt-8 grid max-w-2xl grid-cols-3 gap-4 border-t border-petrikcream/20 pt-5 md:mt-10"
      style="animation-delay: 1.3s"
    >
      {
        STATS.map((stat) => (
          <div>
            <dd
              class="font-display text-2xl font-semibold tabular-nums md:text-4xl"
              data-count-to={stat.value}
              data-count-prefix={stat.prefix}
              data-count-suffix={stat.suffix}
            >
              {stat.prefix}
              {stat.value}
              {stat.suffix}
            </dd>
            <dt class="mt-1 font-body text-[11px] font-semibold uppercase tracking-[0.12em] text-petrikcream/80 md:text-xs">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const element of document.querySelectorAll("[data-count-to]")) {
    const target = Number(element.getAttribute("data-count-to") ?? "0");
    const prefix = element.getAttribute("data-count-prefix") ?? "";
    const suffix = element.getAttribute("data-count-suffix") ?? "";

    if (reduceMotion || !Number.isFinite(target)) continue;

    const duration = 1800;
    const startedAt = performance.now() + 1400;

    const tick = (now: number) => {
      const progress = Math.min(Math.max((now - startedAt) / duration, 0), 1);
      const value = Math.round(target * (1 - Math.pow(1 - progress, 4)));
      element.textContent = `${prefix}${value}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }

  // The molecule canvas of the hero, ported from the old site (no dependencies).
  const canvas = document.querySelector<HTMLCanvasElement>("[data-molecule-field]");
  const ctx = canvas?.getContext("2d");

  if (canvas && ctx) {
    const COLORS = ["#85C1B6", "#85C1B6", "#2B8272", "#B1D258"];
    const LINK_DIST = 140;
    const MOUSE_DIST = 190;
    const mouse = { x: -9999, y: -9999 };

    type Node = { x: number; y: number; vx: number; vy: number; r: number; color: string };

    let width = 0;
    let height = 0;
    let nodes: Node[] = [];
    let frame = 0;
    let startedAt = performance.now();

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.min(120, Math.round((width * height) / 11000));
      nodes = Array.from({ length: count }, () => {
        const angle = Math.random() * Math.PI * 2;
        const speed = 6 + Math.random() * 14;
        return {
          x: width * 0.6,
          y: height * 0.5,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          r: 1.5 + Math.random() * 2.5,
          color: COLORS[Math.floor(Math.random() * COLORS.length)] ?? COLORS[0]!,
        };
      });
      if (reduceMotion) {
        for (const node of nodes) {
          node.x = Math.random() * width;
          node.y = Math.random() * height;
          node.vx = node.vy = 0;
        }
      }
      startedAt = performance.now();
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      const age = (performance.now() - startedAt) / 1000;
      const damp = age < 1.4 ? 0.955 : 0.99;

      for (const node of nodes) {
        const dx = node.x - mouse.x;
        const dy = node.y - mouse.y;
        const distance = Math.hypot(dx, dy);
        if (distance < MOUSE_DIST && distance > 0.1) {
          const force = (1 - distance / MOUSE_DIST) * 0.9;
          node.vx += (dx / distance) * force * 0.35;
          node.vy += (dy / distance) * force * 0.35;
        }
        node.vx *= damp;
        node.vy *= damp;
        if (age > 1.4 && Math.hypot(node.vx, node.vy) < 0.15) {
          node.vx += (Math.random() - 0.5) * 0.05;
          node.vy += (Math.random() - 0.5) * 0.05;
        }
        node.x += node.vx;
        node.y += node.vy;
        if (node.x < 0 || node.x > width) node.vx *= -1;
        if (node.y < 0 || node.y > height) node.vy *= -1;
        node.x = Math.max(0, Math.min(width, node.x));
        node.y = Math.max(0, Math.min(height, node.y));
      }

      ctx.lineWidth = 1;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i]!;
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j]!;
          const distance = Math.hypot(a.x - b.x, a.y - b.y);
          if (distance < LINK_DIST) {
            ctx.strokeStyle = `rgba(133,193,182,${(1 - distance / LINK_DIST) * 0.35})`;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
        const mouseDistance = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (mouseDistance < MOUSE_DIST + 40) {
          ctx.strokeStyle = `rgba(177,210,88,${(1 - mouseDistance / (MOUSE_DIST + 40)) * 0.7})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.stroke();
        }
      }

      for (const node of nodes) {
        ctx.fillStyle = node.color;
        ctx.shadowColor = node.color;
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.arc(node.x, node.y, node.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.shadowBlur = 0;

      if (!reduceMotion) frame = requestAnimationFrame(draw);
    };

    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", (event) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = event.clientX - rect.left;
      mouse.y = event.clientY - rect.top;
    });
    window.addEventListener("pointerleave", () => {
      mouse.x = mouse.y = -9999;
    });

    resize();
    draw();

    window.addEventListener("pagehide", () => cancelAnimationFrame(frame));
  }
</script>

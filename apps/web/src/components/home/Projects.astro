---
import { translator, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);

const PROJECT_LOGOS: [string, string][] = [
  ["mupa", "home.logoMupa"],
  ["languagecert", "home.logoLanguageCert"],
  ["tempus", "home.logoTempus"],
  ["erasmus", "home.logoErasmus"],
  ["penz7", "home.logoPenz7"],
  ["etwinning", "home.logoEtwinning"],
  ["digitalis", "home.logoDigitalis"],
  ["codeweek", "home.logoCodeweek"],
  ["otpfay", "home.logoOtpFay"],
  ["prosuli", "home.logoProsuli"],
];
---

<section class="min-h-max w-full max-w-screen overflow-x-hidden bg-petrikbg ">
  <div class="mx-auto flex w-full max-w-[1240px] flex-col gap-10 px-5 sm:px-10">
    <h2 class="font-display text-3xl font-semibold leading-tight tracking-[-0.02em] text-balance text-petrikink md:text-4xl">
      {t("home.projectsTitle")}
    </h2>
    <p class="max-w-2xl text-base leading-relaxed text-petriksoft md:text-lg">
      {t("home.projectsLead")}
    </p>
  </div>
  <div
    class="mx-auto mt-10 flex w-full max-w-[1240px] items-center gap-x-10 gap-y-12 overflow-x-auto px-5 pb-4 sm:px-10 md:grid md:grid-cols-5 md:overflow-visible"
  >
    {
      PROJECT_LOGOS.map(([name, key]) => (
        <picture class="contents">
          <source type="image/webp" srcset={`/img/partners/${name}.webp`} />
          <img
            src={`/img/partners/${name}.png`}
            alt={t(key)}
            loading="lazy"
            class="h-32 w-40 shrink-0 object-contain md:w-full"
          />
        </picture>
      ))
    }
  </div>
</section>

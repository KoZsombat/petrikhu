---
import Layout from "../../layouts/Layout.astro";
import Callout from "../../components/ui/Callout.astro";
import CardGrid from "../../components/ui/CardGrid.astro";
import FactList from "../../components/ui/FactList.astro";
import PageHero from "../../components/ui/PageHero.astro";

export const prerender = true;
---

<Layout locale="en" alternates={{ hu: "/elerhetoseg" }} title={"Contact details"} description={"Budapest Technical Vocational Training Centre – Petrik Lajos Bilingual Technical School"} canonicalPath={"/en/contact"}>
  <PageHero breadcrumb={[{"label": "Home", "href": "/en"}, {"label": "Contact"}, {"label": "Contact details"}]} title={"Contact details"} intro={"Budapest Technical Vocational Training Centre – Petrik Lajos Bilingual Technical School"} />
  <FactList heading={"General contact details"} rows={[{"label": "Postal address", "value": "1146 Budapest, Thököly út 48-54."}, {"label": "Phone", "value": "+36 70 502 1724 (B reception) · +36 70 502 1723 (A reception)"}, {"label": "E-mail", "value": "info@petrik.hu"}, {"label": "Web", "value": "www.petrik.hu"}, {"label": "OM identifier", "value": "203 058"}, {"label": "Technical code", "value": "520413"}]} />
  <CardGrid variant={"text"} items={[{"eyebrow": "Maintainer", "title": "Budapest Technical Vocational Training Centre", "text": "Postal address: 1149 Budapest, Várna utca 23.\nWeb: www.bmszc.hu\nOM identifier: 203058\nTax number: 15831880-2-42\nDirector General: Csordás Katalin\nChancellor: Viszkok Mihály", "href": "http://www.bmszc.hu", "linkLabel": "www.bmszc.hu →"}, {"eyebrow": "School", "title": "Petrik Lajos Bilingual Technical School", "text": "Postal address: 1146 Budapest, Thököly út 48-54.\nE-mail: info@petrik.hu\nA reception: +36 70 502 1723\nB reception: +36 70 502 1724\nOM identifier: 203 058\nTechnical code: 520413"}, {"eyebrow": "Foundation", "title": "Petrik Foundation", "text": "Postal address: 1146 Budapest, Thököly út 48-54.\nTax number: 19674959-1-42\nBank account number: 11714006-20266635"}]} columns={3} heading={"The institution and its maintainers"} />
  <CardGrid variant={"person"} items={[{"name": "Gál-Berey Csilla", "role": "Principal", "phone": "+36 70 502 1719", "email": "galberey@petrik.hu", "room": "Consultation hours: by appointment, via titkarsag@petrik.hu."}, {"name": "Penksza Károlyné", "role": "General Deputy Principal", "phone": "+36 70 502 1792", "email": "asztalos@petrik.hu"}, {"name": "Bátki Ottilia", "role": "Deputy Principal for Vocational Training", "phone": "+36 70 502 1791", "email": "batki.ottilia@petrik.hu"}, {"name": "Sárközi-Paulik Brigitta", "role": "Deputy Principal", "phone": "+36 70 506 9336", "email": "paulik@petrik.hu"}, {"name": "Szolnok Ádám", "role": "Deputy Principal for Organisation and Communication", "phone": "+36 70 502 1765", "email": "szolnok@petrik.hu"}]} columns={3} heading={"School leadership"} />
  <Callout title={"Academic administration officers"} html={"<p>For student administration, the Student Centre is available on weekdays between 9:00 and 14:00.</p>"} />
  <CardGrid variant={"person"} items={[{"name": "Lévai Viktória", "role": "Principal's secretariat", "phone": "+36 70 502 1708", "email": "titkarsag@petrik.hu"}, {"name": "Jókuthy Claudia", "role": "Finance administrator", "phone": "+36 70 502 1717", "email": "gazdasagi@petrik.hu"}, {"name": "Aranyos Emese", "role": "Student Centre administrator", "phone": "+36 70 502 1736", "email": "aranyos.emese@petrik.hu"}, {"name": "Horváthné Szirai Szilvia", "role": "Student Centre administrator", "phone": "+36 70 502 1716", "email": "horvathne.szirai.szilvia@petrik.hu"}]} columns={4} />
  <CardGrid variant={"person"} items={[{"name": "Dr. Tóth-Vajna Zsombor", "role": "School doctor", "phone": "+36 70 502 1728", "email": "orvosi@petrik.hu", "room": "Consultation hours: Monday and Wednesday 9:30–14:00"}, {"name": "Pezenhoffer Tímea", "role": "School nurse", "phone": "+36 70 502 1728", "email": "orvosi@petrik.hu", "room": "Consultation hours: Monday to Thursday 9:30–14:00"}, {"name": "Petrács Zsuzsanna", "role": "Special education teacher", "phone": "+36 70 502 1724", "email": "petracs.zsuzsanna@petrik.hu"}, {"name": "Pál Bottyán László", "role": "School psychologist", "phone": "+36 70 502 1813", "email": "lelkiero@yahoo.com", "room": "Open day for students: during term time, by arrangement (B044).\nOpen day for parents: by prior arrangement by phone."}, {"name": "Ujházy Veronika", "role": "Social support worker", "phone": "+36 70 502 2719", "email": "borbely.veronika@petrik.hu", "room": "Consultation hours: Monday 9:00–12:00\nBy phone on working days 10:00–18:00"}]} columns={3} heading={"Health and support staff"} />
  <CardGrid variant={"person"} items={[{"name": "Kulcsár Anikó", "role": "Leisure activities organiser", "phone": "+36 70 502 1739", "email": "kulcsara@petrik.hu"}, {"name": "Sütő Éva", "role": "Librarian", "phone": "+36 70 502 1726", "email": "esuto@petrik.hu", "room": "Library opening hours:\nMonday 9:00–16:00 · Tuesday 9:00–14:00\nWednesday 8:30–14:30 · Thursday 9:00–14:00\nFriday 9:00–12:00"}, {"name": "Komlós Zoltán", "role": "Caretaker", "phone": "+36 70 502 1808", "email": "gondnok@petrik.hu"}]} columns={3} heading={"Teacher and student support staff"} />
</Layout>

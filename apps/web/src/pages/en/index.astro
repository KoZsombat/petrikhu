---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/home/Hero.astro";
import LatestNews from "../../components/home/LatestNews.astro";
import Programmes from "../../components/home/Programmes.astro";
import Reasons from "../../components/home/Reasons.astro";
import Projects from "../../components/home/Projects.astro";
import Introduction from "../../components/home/Introduction.astro";
import Partners from "../../components/home/Partners.astro";
import { getPosts, type PostSummary } from "../../lib/api";

export const prerender = false;

let posts: PostSummary[] = [];
try {
  posts = (await getPosts({ limit: 8 })).posts;
} catch {
  // A fresh database may have no posts yet, or the API may be starting.
}
---

<Layout locale="en" canonicalPath="/en" alternates={{ hu: "/" }}>
  <Hero locale="en" />
  <LatestNews locale="en" posts={posts} />
  <Programmes locale="en" />
  <Reasons locale="en" />
  <Projects locale="en" />
  <Introduction locale="en" />
  <Partners locale="en" />
</Layout>

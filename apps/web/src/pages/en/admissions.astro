---
import Layout from "../../layouts/Layout.astro";
import Accordion from "../../components/ui/Accordion.astro";
import Callout from "../../components/ui/Callout.astro";
import CardGrid from "../../components/ui/CardGrid.astro";
import CtaBand from "../../components/ui/CtaBand.astro";
import DataTable from "../../components/ui/DataTable.astro";
import FactList from "../../components/ui/FactList.astro";
import NewsRows from "../../components/ui/NewsRows.astro";
import PageHero from "../../components/ui/PageHero.astro";

export const prerender = true;
---

<Layout locale="en" alternates={{ hu: "/nyolcadikos" }} title={"For 8th graders – at the gateway to further study"} description={"At the gateway to further study – marketable, 21st-century education at Petrik."} canonicalPath={"/en/admissions"}>
  <PageHero breadcrumb={[{"label": "Home", "href": "/en"}, {"label": "Education"}, {"label": "For 8th graders"}]} title={"For 8th graders – at the gateway to further study"} intro={"At the gateway to further study – marketable, 21st-century education at Petrik."} />
  <CardGrid variant={"text"} items={[{"eyebrow": "01", "title": "What is Petrik?", "text": "One of Budapest's oldest secondary vocational institutions, it celebrated the 140th anniversary of its founding in 2019. Our namesake, Lajos Petrik, was a famous teacher and later principal of the school: his versatility and his value-centred, student-centred worldview still point the way today."}, {"eyebrow": "02", "title": "What does Petrik offer?", "text": "Alongside the traditional chemical industry programme, you can study in the environmental protection and water management and the IT and telecommunications sectors. At the end of the 5 years (6 in the bilingual classes), in addition to the school-leaving exam you also receive a technician diploma."}, {"eyebrow": "03", "title": "What more does it offer?", "text": "Modern laboratories, specialist classrooms, national and international competitions, Erasmus+ projects with 9 EU countries, eTwinning, Coding Week, Digital Theme Week, Pénz7 and Sustainability Theme Week."}]} columns={3} />
  <Callout tone={"info"} title={"Applying for admission"} html={"<p>The application forms must be filled in at the primary school, which sends them on to the secondary schools.</p><p>For the study areas with codes <strong>0091, 0092, 0093, 0094</strong>, admission is based on the academic points, and the combined points obtained in the central written exam and the local oral interview, under identical conditions.</p>"} />
  <DataTable heading={"Selectable study areas, sectors (5 starting classes per year)"} columns={["Code", "Sector", "Programme", "Places", "Diploma / qualification", "Features"]} rows={[{"cells": ["0091", "Chemical industry sector", "Bilingual chemical technician\n5+1-year bilingual chemistry programme", "28 students", "Certified technician (ELTE)\nchemical technician; specialisations: general laboratory technician, production process controller", "Advanced-level English language teaching; mathematics, chemistry, vocational chemistry in English; natural science subjects; laboratory practicals; talent development"]}, {"cells": ["0092", "Chemical industry sector", "Chemical technician\n5-year chemistry programme", "32 students", "chemical technician; specialisations: general laboratory technician, production process controller", "High-level chemistry teaching; natural science subjects; laboratory practicals; English or German as a foreign language; talent development"]}, {"cells": ["0093", "Environmental protection and water management sector", "Environmental protection technician\n5-year environmental protection programme", "32 students", "Certified technician (Óbuda University)\nenvironmental protection technician; specialisation: environmental protection", "Advanced-level biology teaching; natural science subjects; environmental protection practicals; English or German as a foreign language; talent development"]}, {"cells": ["0094", "Bilingual IT", "Software developer and tester; IT system and application operator technician\n5-year IT programme", "32 students\n(16 students certified software developer)", "Certified technician – Software developer and tester (Óbuda University)", "Advanced-level English language teaching; mathematics, digital culture, civilisation in English; both professions selectable; web programming, software development, system administration and networking knowledge; talent development"]}, {"cells": ["0095", "IT and telecommunications sector", "Software developer and tester; IT system and application operator technician\n5-year IT programme", "32 students\n(16 + 16 students)", "Certified technician – Software developer and tester (Óbuda University)\n\"Three-in-one\" BProf programme – IT system and application operator (BME)", "Both professions selectable; advanced-level IT teaching; web programming, software development, system administration and networking knowledge; talent development"]}]} footnote={"Sector capacity: 0091 – 26 students, 0092 – 32 students, 0093 – 32 students, 0094 – 32 students, 0095 – 32 students."} />
  <FactList heading={"Admission dates"} rows={[{"label": "Submission of the application form", "value": "by 1 December 2026 at the latest"}, {"label": "Central, standardised written exam", "value": "23 January 2027, 10:00 (make-up day: 3 February 2027, 14:00)"}, {"label": "Oral exam", "value": "16 March 2027 – according to the schedule published on the website"}]} />
  <Callout tone={"info"} html={"<p>For the standardised, central written exam, you must apply on a separate application form to the school where the applicant wishes to take the exam.</p>"} />
  <CtaBand title={"Admissions information"} buttonLabel={"Admissions guide for 8th graders"} href={"https://petrik.hu/wp-content/uploads/2026/10/Petrik_-felveteli-tajekoztato_2027_2028-1.pdf"} />
  <Accordion heading={"About the entrance exam"} items={[{"title": "Content of the entrance exam", "html": "<p><strong>Central written exam for all programmes:</strong> mathematics and Hungarian language. For students with dysfunctional disorders, we provide extra time on a request supported by an expert opinion.</p><p><strong>Oral part:</strong> a short, informal general conversation, followed by subject-related questions. Bring your KRÉTA extract, a notebook from any subject and, if you have them, certificates proving your competition results.</p><p>We invite to the oral exam those IT applicants who have achieved at least 60 points from the brought and written points in the case of code 0094 (bilingual), and at least 80 points in the case of code 0095.</p>"}, {"title": "Assessment of the candidate's performance", "html": "<p>It is based on the academic points brought from primary school and the results achieved in the entrance exam.</p><p>Brought results: the end-of-year grades of year 7 and the mid-year grades of year 8 in Hungarian language and literature, history, foreign language, mathematics, physics, chemistry, geography, biology and IT. A grade of excellent (5) is worth 2 points, good (4) 1 point; unsatisfactory, pass and satisfactory (1–3) are worth 0 points. If the grade is excellent in all 10 subjects in each of the two terms, a maximum of 40 points can be obtained in total.</p>"}]} openFirst={true} />
  <DataTable heading={"Basis of the admission decision"} columns={["Source of points", "Details", "Points"]} rows={[{"cells": ["Carried-over points", "Primary school academic results (academic points)", "40"]}, {"cells": ["Central written exam", "Mathematics and native language, 50–50 points\n(for the bilingual IT programme: 50 + 50×2 points)", "100\n(0094: 150)"]}, {"cells": ["Oral interview", "General conversation and subject-related questions", "30"]}, {"cells": ["Total", "Sum of carried-over and earned points", "170\n(0094: 220)"]}]} />
  <NewsRows rows={[{"title": "Enrolment information for future 9th graders – 25–26 June 2026", "excerpt": "Dear future 9th-grade students! On 17 June 2025, the e-Ügyintézés portal will open for parents to submit their children's details to schools via the \"Enrolment in a secondary school\" (BKI) process, until 26 June 2026. The BKI process...", "date": "MÁJ. 12.", "category": "Featured homepage news", "href": "/hirek/beiratkozasi-informaciok-leendo-kilencedikesek-szamara-2026-junius-25-26"}, {"title": "Csibetábor (Chick Camp) 2026", "excerpt": "Dear future Petrik students! The time of our first big meeting is coming soon: the Csibetábor (Chick Camp). Below we would like to share information about the camp with you here on the website as well; we also sent it by post to everyone concerned earlier: The Chick Camp...", "date": "MÁJ. 8.", "category": "Featured homepage news", "href": "/hirek/csibetabor-2026"}, {"title": "Final admission list for the 2026/2027 school year", "excerpt": "Dear 8th-grade applicants! The reconciled admission list is now available, compiled by the Educational Authority based on students' applications and each school's rankings. Congratulations on your successful admission; we will see you soon at enrolment. The successful...", "date": "ÁPR. 27.", "category": "Featured homepage news", "href": "/hirek/vegleges-felveteli-jegyzek-a-2026-2027-tanevre"}, {"title": "SECONDARY SCHOOL ADMISSION: ranking changes open on 25 March 2026!", "excerpt": "The last chance for fine-tuning has arrived. Between 25 and 27 March 2026 you can decide on the final order of your programme choices. What can be changed? On the amended student form: the originally specified order can also be changed on the original student form...", "date": "MÁRC. 24.", "category": "Featured homepage news", "href": "/hirek/kozepfoku-felveteli-2026-marcius-25-en-indul-a-sorrendmodositas"}, {"title": "Provisional admission ranking 2026", "excerpt": "Dear applicants! After the oral admission interviews, we totalled the points and created the provisional admission list. The total score consists of carried-over points (40), written entrance exam points (100) and oral points (30), for a maximum of 170 points. The...", "date": "MÁRC. 16.", "category": "Featured homepage news", "href": "/hirek/ideiglenes-felveteli-lista-2026"}, {"title": "Oral admission schedule, March 2026", "excerpt": "Dear applicants! Below you will find the oral admission schedule planned for 11 March 2026, in which you can search for your education ID using the Ctrl+F key combination. Those who applied for codes 0091, 0092 and 0093 will be called in automatically...", "date": "MÁRC. 3.", "category": "Featured homepage news", "href": "/hirek/szobeli-felveteli-beosztas-2026-marcius"}]} />
  <FactList heading={"School details"} rows={[{"label": "OM identifier", "value": "203058"}, {"label": "School name", "value": "Budapest Technical Vocational Training Centre (BMSZC) Petrik Lajos Bilingual Technical School"}, {"label": "School address", "value": "1146 Budapest, Thököly út 48-54."}, {"label": "Code of the site of service provision", "value": "009"}, {"label": "Technical code", "value": "520 413"}]} />
  <FactList heading={"Details required for the application form"} rows={[{"label": "Type of institution", "value": "technical school (technikum)"}, {"label": "0091 chemical technician", "value": "5+1-year bilingual chemistry programme"}, {"label": "0092 chemical technician", "value": "5-year chemistry programme"}, {"label": "0093 environmental protection technician", "value": "5-year environmental protection programme"}, {"label": "0094 information technology and telecommunications", "value": "5-year IT programme (bilingual)"}]} />
</Layout>

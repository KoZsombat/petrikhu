---
import Layout from "../layouts/Layout.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import DataTable from "../components/ui/DataTable.astro";
import FeatureSection from "../components/ui/FeatureSection.astro";
import LogoGrid from "../components/ui/LogoGrid.astro";
import NewsRows from "../components/ui/NewsRows.astro";
import PageHero from "../components/ui/PageHero.astro";
import RichTextSection from "../components/ui/RichTextSection.astro";

export const prerender = true;
---

<Layout locale="hu" title={"Projektjeink"} description={"Nyelvtanulás, Kúltúra, Szakmai fejlődés, Barátok és Életre szóló élmények"} canonicalPath={"/projekt"}>
  <PageHero breadcrumb={[{"label": "Kezdőlap", "href": "/"}, {"label": "Egyéb"}, {"label": "Projektek"}]} title={"Projektjeink"} intro={"Nyelvtanulás, Kúltúra, Szakmai fejlődés, Barátok és Életre szóló élmények"} />
  <RichTextSection html={"Az Erasmus+ projektek azért jók, mert"} />
  <CardGrid variant={"text"} items={[{"title": "külföldi utazáson vehetsz részt bennük,"}, {"title": "megismerhetsz más kultúrákat, tájakat, embereket,"}, {"title": "életre szóló barátságokat köthetsz,"}, {"title": "izgalmas iskolai programokon vehetsz részt,"}, {"title": "gyakorolhatod az angol nyelvet, így fejlesztve nyelvtudásod,"}, {"title": "olyan témákkal foglalkozhatsz, amelyek nem kerülnek elő tanórákon,"}, {"title": "fejlesztheted a kreativitásod,"}, {"title": "növelheted az önbizalmad, az önállóságodat."}]} columns={3} />
  <FeatureSection title={"Iskolánk Erasmus+ Akkreditációval rendelkezik a szakképzés területén."} imageSide={"left"} html={"<p>Emellett rendszeresen részt veszünk köznevelési projektekben is.</p><p>Az Erasmus+ projektekkel kapcsolatos bővebb információ: <a href=\"https://petrik-erasmus.webnode.hu/\" target=\"_blank\" rel=\"noreferrer\">https://petrik-erasmus.webnode.hu/</a></p><p>A projektekhez kapcsolódó hírek</p>"} />
  <NewsRows rows={[{"title": "Infinity Code – közös küldetés, közös fejlődés", "excerpt": "A Petrikben a Kódolás Hete mára olyan iskolai hagyománnyá vált, amely évről évre összehozza a diákokat és az oktatókat az együtt gondolkodás, a felfedezés és az alkotás öröméért. Az idei Infinity Code szuperhősküldetései új színekkel gazdagították ezt a hagyományt: a...", "date": "OKT. 14.", "category": "#petrikcodeweek2026", "href": "/hirek/infinity-code-kozos-kuldetes-kozos-fejlodes"}, {"title": "Űrbe lépni szülőkkel tilos?!", "excerpt": "Immár harmadik alkalommal rendeztük meg iskolánkban a Kódolás Hete keretében a szülő–diák kódolós workshopot, amelyen idén először oktatók és gyermekeik is részt vehettek. A szervezők célja változatlan volt: a mindennapi élethez kapcsolódó feladatokkal sikerélményt...", "date": "OKT. 12.", "category": "#petrikcodeweek2026", "href": "/hirek/urbe-lepni-szulokkel-tilos"}, {"title": "Infinity Code: az utolsó energiakristálytól az univerzum megmentéséig", "excerpt": "Offline adatvizualizáció, robotautós üldözés, zenelejátszó alkalmazások és egy különleges Minecraft-küldetés várta a csapatokat a Petrik Kódolás Hetének zárónapjain. Az Infinity Code utolsó kihívásai során a résztvevők a hét folyamán szerzett tudásukat és...", "date": "OKT. 9.", "category": "#petrikcodeweek2026", "href": "/hirek/infinity-code-az-utolso-energiakristalytol-az-univerzum-megmenteseig"}, {"title": "Szuperhősküldetések és közös sikerélmények – az Infinity Code első három napja a Petrikben", "excerpt": "Az Infinity Code témahéten 12 diákcsapat és egy oktatói csapat dolgozik az univerzum megmentésén, miközben a résztvevők kreativitása, problémamegoldása és együttműködése is fejlődik. Az első három nap feladatai máris megmutatták, milyen sokféle tantárgyhoz és...", "date": "OKT. 8.", "category": "#petrikcodeweek2026", "href": "/hirek/szuperhoskuldetesek-es-kozos-sikerelmenyek-az-infinity-code-elso-harom-napja-a-petrikben"}, {"title": "Szülő-diák kódolós workshop: jelentkezés megnyitva!", "excerpt": "Kedves petrikes diákok és oktatók! Október 7-én, szerdán 16 órától harmadik alkalommal rendezzük meg szülő–diák kódolós workshopunkat. Hozd el egy szülődet, testvéredet vagy nagyszülődet, és oldjátok meg együtt az idei kihívásokat! Most oktatóink is csatlakozhatnak...", "date": "SZEPT. 25.", "category": "#petrikcodeweek2026", "href": "/hirek/szulo-diak-kodolos-workshop-jelentkezes-megnyitva"}, {"title": "Infinity Code: megnyílt a jelentkezés!", "excerpt": "Kedves petrikes diákok! Megnyílt a jelentkezés az idei Kódolás Hetére! Október 5–9. között ismét csapatokban vághattok neki a kihívásoknak egy izgalmas témahét keretein belül. Négyfős csapatokat várunk csapatnév, valamint a vezető megjelölésével – a tagok...", "date": "SZEPT. 24.", "category": "#petrikcodeweek2026", "href": "/hirek/infinity-code-megnyilt-a-jelentkezes"}]} />
  <LogoGrid label={"Szakmai partnerek"} logos={[{"alt": "Erasmus+", "src": "/media/wp-content/uploads/2020/10/logo-erasmus-plus.png", "href": "https://ec.europa.eu/programmes/erasmus-plus/about_hu"}, {"alt": "Tempus Közalapítvány", "src": "/media/wp-content/uploads/2020/10/tempus_kozalapitvany.png", "href": "https://tka.hu/"}]} />
  <DataTable heading={"Korábbi projektjeink"} columns={["Időszak", "Projekt", "További információ"]} rows={[{"cells": ["2020–2022", "EurDigiCultHer", "—"]}, {"cells": ["2019–2022", "Off the Beaten Path", "[Honlap](https://off-the-beaten-path0.webnode.hu/) · [Facebook](https://www.facebook.com/Erasmus-Off-the-Beaten-Path-102653107887638) · [eTwinning](https://twinspace.etwinning.net/104637/home) · [Instagram](https://www.instagram.com/offthebeatenpatherasmus/)"]}, {"cells": ["2019–2021", "Training for All", "[Facebook](https://www.facebook.com/Erasmus-Training-for-All-106575467584508)"]}, {"cells": ["2017–2019", "Our Common European Tale", "[Honlap](https://our-common-european-tale.webnode.hu/) · [Facebook](https://www.facebook.com/OurCommonEuropeanTale)"]}, {"cells": ["2015–2017", "Math Around Us", "[eTwinning](https://twinspace.etwinning.net/9782/home) · [Facebook](https://www.facebook.com/MathAroundUs/)"]}, {"cells": ["2013–2015", "Training for LIFE: Leadership Initiative for Europe", "[Facebook](https://www.facebook.com/Training-for-Life-Leadership-Initiative-for-Europe-comenius-Project-259066730935222/)"]}]} />
  <CardGrid variant={"person"} items={[{"name": "Szolnok Ádám", "role": "Projektkoordinátor", "room": "A.113 tanári", "email": "szolnok@petrik.hu"}]} columns={3} heading={"A projektek koordinátora"} />
</Layout>

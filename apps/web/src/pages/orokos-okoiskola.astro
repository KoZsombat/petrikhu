---
import Layout from "../layouts/Layout.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import NewsRows from "../components/ui/NewsRows.astro";
import PageHero from "../components/ui/PageHero.astro";
import RichTextSection from "../components/ui/RichTextSection.astro";

export const prerender = true;
---

<Layout locale="hu" title={"Örökös Ökoiskola"} description={"Környezeti nevelés és fenntarthatóság"} canonicalPath={"/orokos-okoiskola"}>
  <PageHero breadcrumb={[{"label": "Kezdőlap", "href": "/"}, {"label": "Egyéb"}, {"label": "Örökös Ökoiskola"}]} title={"Örökös Ökoiskola"} intro={"Környezeti nevelés és fenntarthatóság"} />
  <RichTextSection html={"<p>Kedves Petrikesek! </p><p>Iskolánk elnyerte az Örökös Ökoiskola címet.</p><p>Ökoiskolával kapcsolatos hírek</p>"} />
  <NewsRows rows={[{"title": "Mozdulj  a klímáért!", "excerpt": "Kedves Petrikesek! A Petrik 9.C környezetvédő diákjai is csatlakoznak az országos környezeti nevelési kampányhoz. Ebben a tanévben az Éghajlatvédelmi Szövetség Mozdulj a klímáért! Iskolai kampányában a Petrik iskolánk 9. C osztályos tanulói is bekapcsolódnak. A...", "date": "OKT. 10.", "category": "Hírek", "href": "/hirek/mozdulj-a-klimaert"}, {"title": "Föld napja", "excerpt": "Kedves Petrikesek! A Föld napja alkalmából zöldbe öltözött diákok és tanárok – köszönjük a részvételt! A Liget körüli iskolákkal (Radnóti, Szent István, Teleki) közösen szerveztük ezt a figyelemfelhívó kiállást. Fotó: Preisler...", "date": "ÁPR. 22.", "category": "Hírek", "href": "/hirek/fold-napja"}]} />
  <RichTextSection html={"<h2>Elérhetőség</h2>"} />
  <CardGrid variant={"person"} items={[{"name": "Dr. Szabó Marianna", "room": "B. épület 010", "email": "dr.szabo.marianna@petrik.hu"}]} columns={3} />
  <RichTextSection html={"<h2>Örökös Ökoiskola adatok</h2>"} />
  <CardGrid variant={"text"} items={[{"title": "Intézmény: Petrik Lajos Technikum"}]} columns={3} />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/ui/PageHero.astro";
import TeacherGrid from "../components/teachers/TeacherGrid.astro";
import Prose from "../components/ui/Prose.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import { getTeachers, type Teacher } from "../lib/api";

export const prerender = false;

let teachers: Teacher[] = [];
let error = false;
try {
  teachers = await getTeachers();
} catch {
  error = true;
}
---

<Layout
  locale="hu"
  title="Tanári kar"
  description="Több mint 100 oktató tanítja az iskola diákjait közoktatásban, szakképzésben, nappali és esti munkarendben."
  canonicalPath="/tanari-kar"
>
  <PageHero
    breadcrumb={[
      { label: "Kezdőlap", href: "/" },
      { label: "Kapcsolat" },
      { label: "Tanári kar" },
    ]}
    title="Tanári kar"
    intro="Egységben az erő. Több mint 100 oktató tanítja az iskola diákjait közoktatásban, szakképzésben, nappali és esti munkarendben."
  />

  <div class="border-y border-petriklinesoft bg-petrikbg py-8 md:py-10">
    {
      error ? (
        <div class="mx-auto max-w-3xl px-5">
          <EmptyState
            title="A tanári kar átmenetileg nem érhető el."
            text="Próbáld újra később."
          />
        </div>
      ) : teachers.length === 0 ? (
        <div class="mx-auto max-w-3xl px-5">
          <EmptyState title="Még nincs feltöltött tanár." />
        </div>
      ) : (
        <TeacherGrid teachers={teachers} />
      )
    }
  </div>

  <div class="mx-auto w-full max-w-[1240px] px-5 pb-16 sm:px-10">
    <Prose
      html={"<h2>Levelezési címünk</h2><p>1146 Budapest, Thököly út 48-54.</p><h2>Telefon</h2><p><a href=\"tel:+3613434810\">+36 1 343 4810</a></p><h2>E-mail</h2><p><a href=\"mailto:info@petrik.hu\">info@petrik.hu</a></p>"}
    />
  </div>
</Layout>

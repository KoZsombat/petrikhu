---
import Layout from "../layouts/Layout.astro";
import Accordion from "../components/ui/Accordion.astro";
import AwardsShowcase from "../components/ui/AwardsShowcase.astro";
import FeatureSection from "../components/ui/FeatureSection.astro";
import HistoryRail from "../components/ui/HistoryRail.astro";
import FurtherReading from "../components/ui/FurtherReading.astro";
import PageHero from "../components/ui/PageHero.astro";
import StatCards from "../components/ui/StatCards.astro";
import VideoGrid from "../components/ui/VideoGrid.astro";

export const prerender = true;
---

<Layout locale="hu" alternates={{ en: "/en/about-us" }} title={"Több mint 140 éve az érték a mérték."} description={"Az iskola 1879. december 7-én nyílt meg Állami Ipari Középtanoda néven – azóta a magyar szakképzés egyik legrégebbi, legelismertebb intézménye."} canonicalPath={"/bemutatkozas"}>
  <PageHero breadcrumb={[{"label": "Kezdőlap", "href": "/"}, {"label": "Bemutatkozás"}]} title={"Több mint 140 éve az érték a mérték."} intro={"Az iskola 1879. december 7-én nyílt meg Állami Ipari Középtanoda néven – azóta a magyar szakképzés egyik legrégebbi, legelismertebb intézménye."} />
  <FeatureSection eyebrow={"Az iskola névadója"} title={"Petrik Lajos"} imageSide={"right"} html={"<p>Az iskola névadója, Petrik Lajos 1880-tól tanára, 1905-től 1914-ig pedig igazgatója volt az intézménynek. Életpályáját a tudomány, a képzőművészet és a természet kihívásai iránti nyitottság jellemezte. Egyszerre volt tudós, tanár, keramikus, műgyűjtő és természetjáró.</p>"} />
  <StatCards eyebrow="Számokban" heading="Az iskola ma" items={[{"value": "1178", "label": "Diák", "icon": "users"}, {"value": "120", "label": "Oktató", "icon": "teacher"}, {"value": "35", "label": "Tanterem", "icon": "room"}, {"value": "23", "label": "Labor", "icon": "lab"}]} />
  <HistoryRail heading={"Az iskola története"} intro={"Az iskola történetének főbb állomásai 1879-től napjainkig."} eyebrow={"Idővonal"} rows={[{"key": "1879", "text": "December 7-én megnyitja kapuit az Állami Középipartanoda: gépészet, építészet és vegyészet szakirányok. Első épülete a Főherceg Sándor (ma Gutenberg) tér 4. alatt állt."}, {"key": "1889", "text": "Az iskola a Hauszmann Alajos tervezte új épületegyüttesbe költözik (József körút – Népszínház utca sarka). Igazgatója Hegedűs Károly, aki 35 éven át vezette az intézményt."}, {"key": "1898", "text": "Új neve Magyar Királyi Állami Felső Ipariskola; négy fő szakirány: gépészet, vegyipar, fém- és vasipar, faipar."}, {"key": "1940", "text": "A vegyipari szakirány a Thököly út 48. alatti épületbe költözik, amely ma is az iskola otthona."}, {"key": "1990-es évek", "text": "A hagyományos vegyipari képzés mellé felnő az informatikai és a környezetvédelmi szakemberképzés. 2007/2008-ban az Irinyi János Környezetvédelmi és Vegyipari Szakközépiskolával egyesülve a Petrik az ország legnagyobb környezetvédelmi és vegyipari képzőhelye lesz."}, {"key": "2015", "text": "Július 1-jétől az iskola fenntartója a Budapesti Műszaki Szakképzési Centrum."}, {"key": "2019", "text": "Az iskola fennállásának 140. évfordulója. A HVG „Középiskola 2019” kiadványában a szakgimnáziumok rangsorában országosan a 10. helyen végez."}]} />
  <Accordion heading={"Iskolánkról"} items={[{"title": "Hitvallásunk és céljaink", "html": "<p>A névadónk, <strong>Petrik Lajos</strong> által képviselt sokoldalúság, az értékek befogadása és továbbadása az a cél, amelyre iskolánk múltja, jelene és jövője épül. Célunk a <strong>tanulócentrikus</strong>, és ezen keresztül <strong>partnerközpontú</strong> iskola működtetése. Iskolánk <strong>nyitott</strong> a társadalmi elvárások és a <strong>változó munkaerő-piaci igények</strong> irányába, folytonos <strong>újítással, megújulással</strong> törekszik e feladatok ellátására, és kölcsönösen együttműködik szakmai partnereivel.</p><p>Oktató-nevelő munkánk során figyelembe vesszük és beépítjük programunkba a szülők, a tanulók és a munkáltatók igényeit. A tanulók az iskola két épületében található korszerű, jól felszerelt tantermekben, laboratóriumokban, informatikai és ipari modellező műhelyekben sajátíthatják el a szakmák elméleti és gyakorlati ismereteit.</p>"}, {"title": "Híres egykori diákjaink", "html": "<p>Iskolánk mindig nagy gondot fordított arra, hogy tanulóinak képességeit minél szélesebb körben kibontakoztassa, és az elismerten magas színvonalú szakképzés mellett magasabb szintű általános műveltséget is adjon. Egykori diákjaink között köszönthetjük többek között <strong>Nádas Péter</strong> világhírű írót, <strong>Vajda Mihály</strong> filozófust, a Budapesti Iskola egyik alapítóját, <strong>Kovács László</strong> egykori külügyminisztert, európai uniós biztost, valamint a magyar komoly- és könnyűzene olyan kimagasló alakjait, mint <strong>Oberfrank Géza</strong>, az Operaház egykori karnagya, <strong>Demjén Ferenc</strong>, <strong>Korda György</strong> és <strong>Földes László (Hobo)</strong>.</p>"}, {"title": "Nemzetközi kapcsolatok", "html": "<p>Kiemelt figyelmet fordítunk a nemzetközi kapcsolatok ápolására, folyamatosan részt veszünk az Erasmus+ programban. Jelenleg Dániában, Portugáliában, Lengyelországban, Horvátországban, Spanyolországban, Görögországban, Litvániában, Olaszországban és Cipruson vannak partneriskoláink, partnerintézményeink.</p>"}, {"title": "Elismerések és fenntartó", "html": "<p>Iskolánk a HVG „Középiskola 2019” című kiadványában a szakgimnáziumok rangsorában az országos 10. helyezést érte el. A kiadvány szerint „A rangsorban élen végzett szakgimnáziumok a szakképzés elitjébe tartoznak […]”.</p><p>Iskolánk fenntartója 2015. július 1-je óta a Budapesti Műszaki Szakképzési Centrum.</p>"}]} openFirst={true} />
  <VideoGrid
    items={[
      { heading: "Iskolatörténet", url: "https://www.youtube.com/watch?v=d3YG5QNkXA8", title: "Iskolatörténet" },
      { heading: "Petrik Lajos", url: "https://www.youtube.com/watch?v=GHqyCVSEb7M", title: "Petrik Lajos" },
    ]}
  />
  <AwardsShowcase intro={"Az iskola oktatóinak és projektjeinek elismerései 1999 és 2020 között."} heading={"Díjak és elismerések"} columns={["Időpont", "Elismerés"]} rows={[{"cells": ["2013. május", "Nemzetközi Együttműködési Kultúráért Nívódíj – a „Játszunk Kémiát!” című Leonardo projektért"]}, {"cells": ["2018. május 18.", "Digitális Témahét 2018 – Innovatív Pedagógus díj Tóth Éva projektvezetőnek a Be Digitally Aware projektért"]}, {"cells": ["2019. június 8.", "Digitális Témahét 2019 – pedagógus pályázat II. helyezés Tóth Éva projektvezetőnek a WorkIT című projekttel"]}, {"cells": ["2019. június 8.", "Digitális Témahét 2019 – Oracle Academy Program „Kódolj STEM projektet!” különdíj a WorkIt című projektért, szakképző intézményi kategóriában"]}, {"cells": ["2020. március 12.", "#petrikcodeweek intézményi különdíj a Kódolás Hete versenyben (DPMK – 2019/10)\nSzakképzési Díj 2020 – Innováció kategória, a Digitális Témahét a Petrikben: WorkIt című projektért"]}, {"cells": ["2020. július 1.", "Digitális Témahét 2020 – „Nívódíjas Pedagógus” különdíj Tóth Éva projektvezetőnek a Socially Re-designed című projektért"]}, {"cells": ["2020–1999", "Richter Gedeon Alapítvány – Magyar Kémiaoktatásért Díj\n2020 – Dr. Dóbéné Cserjés Edit · 2016 – Vámos István · 2015 – Dr. Stankovics Éva · 2013 – Baranyiné C. Veres Anna · 2005 – Fogarasi József · 2004 – Dr. Lovas Zoltánné · 2003 – Ütő Piroska · 2000 – Kisszékelyi Gyuláné · 1999 – Surányi Istvánné"]}]} />
  <FurtherReading heading={"További olvasnivaló"} intro={"Az iskola múltjáról és épületeiről szóló írások."} items={[{"title": "Az iskola B épületének története", "href": "https://petrikbepulet.webnode.hu/", "meta": "petrikbepulet.webnode.hu"}]} />
</Layout>

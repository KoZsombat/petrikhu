---
import Layout from "../layouts/Layout.astro";
import Callout from "../components/ui/Callout.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import FactList from "../components/ui/FactList.astro";
import PageHero from "../components/ui/PageHero.astro";

export const prerender = true;
---

<Layout locale="hu" alternates={{ en: "/en/contact" }} title={"Elérhetőség"} description={"Budapesti Műszaki Szakképzési Centrum – Petrik Lajos Két Tanítási Nyelvű Technikum"} canonicalPath={"/elerhetoseg"}>
  <PageHero breadcrumb={[{"label": "Kezdőlap", "href": "/"}, {"label": "Kapcsolat", "href": "/kapcsolat"}, {"label": "Elérhetőség"}]} title={"Elérhetőség"} intro={"Budapesti Műszaki Szakképzési Centrum – Petrik Lajos Két Tanítási Nyelvű Technikum"} />
  <FactList heading={"Általános elérhetőség"} rows={[{"label": "Levelezési cím", "value": "1146 Budapest, Thököly út 48-54."}, {"label": "Telefon", "value": "+36 70 502 1724 (B porta) · +36 70 502 1723 (A porta)"}, {"label": "E-mail", "value": "info@petrik.hu"}, {"label": "Web", "value": "www.petrik.hu"}, {"label": "OM azonosító", "value": "203 058"}, {"label": "Technikai kód", "value": "520413"}]} />
  <CardGrid variant={"text"} items={[{"eyebrow": "Fenntartó", "title": "Budapesti Műszaki Szakképzési Centrum", "text": "Levelezési cím: 1149 Budapest, Várna utca 23.\nWeb: www.bmszc.hu\nOM azonosító: 203058\nAdószám: 15831880-2-42\nFőigazgató: Csordás Katalin\nKancellár: Viszkok Mihály", "href": "http://www.bmszc.hu", "linkLabel": "www.bmszc.hu →"}, {"eyebrow": "Iskola", "title": "Petrik Lajos Két Tanítási Nyelvű Technikum", "text": "Levelezési cím: 1146 Budapest, Thököly út 48-54.\nE-mail: info@petrik.hu\nA porta: +36 70 502 1723\nB porta: +36 70 502 1724\nOM azonosító: 203 058\nTechnikai kód: 520413"}, {"eyebrow": "Alapítvány", "title": "Petrik Alapítvány", "text": "Levelezési cím: 1146 Budapest, Thököly út 48-54.\nAdószám: 19674959-1-42\nSzámlaszám: 11714006-20266635"}]} columns={3} heading={"Az intézmény és fenntartói"} />
  <CardGrid variant={"person"} items={[{"name": "Gál-Berey Csilla", "role": "Igazgató", "phone": "+36 70 502 1719", "email": "galberey@petrik.hu", "room": "Fogadóóra: időpont egyeztetés szerint, a titkarsag@petrik.hu címen."}, {"name": "Penksza Károlyné", "role": "Általános igazgatóhelyettes", "phone": "+36 70 502 1792", "email": "asztalos@petrik.hu"}, {"name": "Bátki Ottilia", "role": "Szakmai igazgatóhelyettes", "phone": "+36 70 502 1791", "email": "batki.ottilia@petrik.hu"}, {"name": "Sárközi-Paulik Brigitta", "role": "Igazgatóhelyettes", "phone": "+36 70 506 9336", "email": "paulik@petrik.hu"}, {"name": "Szolnok Ádám", "role": "Szervezésért és kommunikációért felelős igazgatóhelyettes", "phone": "+36 70 502 1765", "email": "szolnok@petrik.hu"}]} columns={3} heading={"Az iskola vezetői"} />
  <Callout title={"Tanügyigazgatási ügyintézők"} html={"<p>Tanulói ügyintézés céljából a Diákcentrum hétköznap 9:00–14:00 között érhető el.</p>"} />
  <CardGrid variant={"person"} items={[{"name": "Lévai Viktória", "role": "Igazgatói titkárság", "phone": "+36 70 502 1708", "email": "titkarsag@petrik.hu"}, {"name": "Jókuthy Claudia", "role": "Gazdasági ügyintéző", "phone": "+36 70 502 1717", "email": "gazdasagi@petrik.hu"}, {"name": "Aranyos Emese", "role": "Diákcentrum ügyintéző", "phone": "+36 70 502 1736", "email": "aranyos.emese@petrik.hu"}, {"name": "Horváthné Szirai Szilvia", "role": "Diákcentrum ügyintéző", "phone": "+36 70 502 1716", "email": "horvathne.szirai.szilvia@petrik.hu"}]} columns={4} />
  <CardGrid variant={"person"} items={[{"name": "Dr. Tóth-Vajna Zsombor", "role": "Iskolaorvos", "phone": "+36 70 502 1728", "email": "orvosi@petrik.hu", "room": "Rendelési idő: hétfő és szerda 9:30–14:00"}, {"name": "Pezenhoffer Tímea", "role": "Védőnő", "phone": "+36 70 502 1728", "email": "orvosi@petrik.hu", "room": "Rendelési idő: hétfőtől csütörtökig 9:30–14:00"}, {"name": "Petrács Zsuzsanna", "role": "Fejlesztő pedagógus", "phone": "+36 70 502 1724", "email": "petracs.zsuzsanna@petrik.hu"}, {"name": "Pál Bottyán László", "role": "Iskolapszichológus", "phone": "+36 70 502 1813", "email": "lelkiero@yahoo.com", "room": "Fogadónap diákoknak: tanítási időben, egyeztetés alapján (B044).\nFogadónap szülőknek: előzetes telefonos egyeztetés alapján."}, {"name": "Ujházy Veronika", "role": "Szociális segítő", "phone": "+36 70 502 2719", "email": "borbely.veronika@petrik.hu", "room": "Fogadóóra: hétfő 9:00–12:00\nTelefonon munkanapokon 10:00–18:00"}]} columns={3} heading={"Egészségügyi és segítő munkatársak"} />
  <CardGrid variant={"person"} items={[{"name": "Kulcsár Anikó", "role": "Szabadidő-szervező", "phone": "+36 70 502 1739", "email": "kulcsara@petrik.hu"}, {"name": "Sütő Éva", "role": "Könyvtáros", "phone": "+36 70 502 1726", "email": "esuto@petrik.hu", "room": "Könyvtári nyitva tartás:\nhétfő 9:00–16:00 · kedd 9:00–14:00\nszerda 8:30–14:30 · csütörtök 9:00–14:00\npéntek 9:00–12:00"}, {"name": "Komlós Zoltán", "role": "Gondnok", "phone": "+36 70 502 1808", "email": "gondnok@petrik.hu"}]} columns={3} heading={"Tanári és tanulói segítők"} />
</Layout>

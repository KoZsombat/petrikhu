---
import Layout from "../layouts/Layout.astro";
import Section from "../components/ui/Section.astro";
---

<Layout locale="hu" title="Az oldal nem található" noindex>
  <Section>
    <div class="mx-auto max-w-3xl">
      <h1 class="font-display text-3xl font-bold">Az oldal nem található</h1>
      <p class="mt-4 text-petriksoft">A keresett oldal nem létezik vagy eltávolították.</p>
      <a href="/" class="mt-6 inline-block font-semibold text-petrikaccentdark underline">
        Vissza a kezdőlapra
      </a>
    </div>
  </Section>
</Layout>

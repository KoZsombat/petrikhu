---
import Layout from "../layouts/Layout.astro";
import Accordion from "../components/ui/Accordion.astro";
import Callout from "../components/ui/Callout.astro";
import CardGrid from "../components/ui/CardGrid.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import DataTable from "../components/ui/DataTable.astro";
import FactList from "../components/ui/FactList.astro";
import NewsRows from "../components/ui/NewsRows.astro";
import PageHero from "../components/ui/PageHero.astro";

export const prerender = true;
---

<Layout locale="hu" alternates={{ en: "/en/admissions" }} title={"Nyolcadikosoknak – a továbbtanulás kapujában"} description={"A továbbtanulás kapujában – piacképes, 21. századi képzés a Petrikben."} canonicalPath={"/nyolcadikos"}>
  <PageHero breadcrumb={[{"label": "Kezdőlap", "href": "/"}, {"label": "Oktatás"}, {"label": "Nyolcadikosoknak"}]} title={"Nyolcadikosoknak – a továbbtanulás kapujában"} intro={"A továbbtanulás kapujában – piacképes, 21. századi képzés a Petrikben."} />
  <CardGrid variant={"text"} items={[{"eyebrow": "01", "title": "Mi a Petrik?", "text": "Budapest egyik legrégibb középfokú szakképző intézménye, 2019-ben ünnepelte fennállásának 140. évfordulóját. Névadónk, Petrik Lajos az iskola egykori híres tanára és későbbi igazgatója: sokoldalúsága, értékközpontú és diákcentrikus világnézete ma is irányt mutat."}, {"eyebrow": "02", "title": "Mit kínál a Petrik?", "text": "A hagyományos vegyipari képzés mellett környezetvédelem és vízügy, valamint informatika és távközlés ágazatokban tanulhatsz. Az 5 (két tanítási nyelvű osztályban 6) év végén az érettségi mellé technikusi oklevelet is kapsz."}, {"eyebrow": "03", "title": "Miben nyújt többet?", "text": "Korszerű laboratóriumok, szaktantermek, országos és nemzetközi versenyek, Erasmus+ projektek 9 uniós országgal, eTwinning, Kódolás Hete, Digitális Témahét, Pénz7 és Fenntarthatósági Témahét."}]} columns={3} />
  <Callout tone={"info"} title={"Felvételire jelentkezés"} html={"<p>A jelentkezési lapokat az általános iskolában kell kitölteni, és ezt az általános iskola küldi el a középiskoláknak.</p><p>A <strong>0091, 0092, 0093, 0094</strong> kódszámú tanulmányi területekre a felvétel a tanulmányi pontok, a központi írásbeli vizsgán és a helyi szóbeli beszélgetésen szerzett összesített pontok alapján, azonos feltételekkel történik.</p>"} />
  <DataTable heading={"Választható tanulmányi területek, ágazatok (évente 5 induló osztály)"} columns={["Kód", "Ágazat", "Képzés", "Létszám", "Oklevél / végzettség", "Jellemzők"]} rows={[{"cells": ["0091", "Vegyipari ágazat", "Két tanítási nyelvű vegyész technikus\n5+1 éves két tanítási nyelvű vegyészképzés", "28 fő", "Okleveles technikus (ELTE)\nvegyész technikus; szakmairányok: általános laboráns, termelési folyamatirányító", "Emelt szintű angol nyelvoktatás; matematika, kémia, szakmai kémia angolul; természettudományos tantárgyak; laboratóriumi gyakorlatok; tehetséggondozás"]}, {"cells": ["0092", "Vegyipari ágazat", "Vegyész technikus\n5 éves vegyészképzés", "32 fő", "vegyész technikus; szakmairányok: általános laboráns, termelési folyamatirányító", "Magas szintű kémiaoktatás; természettudományos tantárgyak; laboratóriumi gyakorlatok; angol vagy német idegen nyelv; tehetséggondozás"]}, {"cells": ["0093", "Környezetvédelem és vízügyi ágazat", "Környezetvédelmi technikus\n5 éves környezetvédelmi képzés", "32 fő", "Okleveles technikus (Óbudai Egyetem)\nkörnyezetvédelmi technikus; szakmairány: környezetvédelem", "Emelt szintű biológiaoktatás; természettudományos tantárgyak; környezetvédelmi gyakorlatok; angol vagy német idegen nyelv; tehetséggondozás"]}, {"cells": ["0094", "Két tanítási nyelvű informatika", "Szoftverfejlesztő és -tesztelő; Informatikai rendszer- és alkalmazás-üzemeltető technikus\n5 éves informatikai képzés", "32 fő\n(16 fő okleveles szoftverfejlesztő)", "Okleveles technikus – Szoftverfejlesztő és -tesztelő (Óbudai Egyetem)", "Emelt szintű angol nyelvoktatás; matematika, digitális kultúra, civilizáció angolul; mindkét szakma választható; webprogramozás, szoftverfejlesztés, rendszergazdai és hálózati ismeretek; tehetséggondozás"]}, {"cells": ["0095", "Informatika és távközlés ágazat", "Szoftverfejlesztő és -tesztelő; Informatikai rendszer- és alkalmazás-üzemeltető technikus\n5 éves informatikai képzés", "32 fő\n(16 + 16 fő)", "Okleveles technikus – Szoftverfejlesztő és -tesztelő (Óbudai Egyetem)\n„Három az egyben” BProf képzés – Informatikai rendszer- és alkalmazás-üzemeltető (BME)", "Mindkét szakma választható; emelt szintű informatikaoktatás; webprogramozás, szoftverfejlesztés, rendszergazdai és hálózati ismeretek; tehetséggondozás"]}]} footnote={"Az ágazatok létszámkerete: 0091 – 26 fő, 0092 – 32 fő, 0093 – 32 fő, 0094 – 32 fő, 0095 – 32 fő."} />
  <FactList heading={"Felvételi időpontok"} rows={[{"label": "Jelentkezési lap benyújtása", "value": "legkésőbb 2026. december 1."}, {"label": "Központi, egységes írásbeli vizsga", "value": "2027. január 23., 10 óra (pótnap: 2027. február 3., 14 óra)"}, {"label": "Szóbeli vizsga", "value": "2027. március 16. – a honlapon közzétett beosztás alapján"}]} />
  <Callout tone={"info"} html={"<p>Az egységes, központi írásbeli vizsgára külön jelentkezési lapon kell jelentkezni abba az iskolába, ahol a felvételiző a vizsgát meg kívánja írni.</p>"} />
  <CtaBand title={"Beiskolázási tájékoztató"} buttonLabel={"Nyolcadikosok beiskolázási ismertetője"} href={"https://petrik.hu/wp-content/uploads/2026/10/Petrik_-felveteli-tajekoztato_2027_2028-1.pdf"} />
  <Accordion heading={"A felvételi vizsgáról"} items={[{"title": "A felvételi vizsga tartalma", "html": "<p><strong>Központi írásbeli vizsga minden szakon:</strong> matematika és anyanyelv. A diszfunkciós zavarokkal küzdő tanulóknak – szakvéleménnyel alátámasztott kérelemre – több időt biztosítunk.</p><p><strong>Szóbeli rész:</strong> rövid, kötetlen általános beszélgetés, majd szakmai kérdések. Hozd magaddal a KRÉTA-kivonatot, bármelyik tantárgyból egy füzetet és – ha van – a versenyeredményeidet igazoló okleveleket.</p><p>Szóbelire azokat az informatikus felvételizőket hívjuk be, akik a hozott és az írásbeli pontokból a 0094-es kódszám (két tanítási nyelv) esetén legalább 60, a 0095-ös kódszám esetén legalább 80 pontot értek el.</p>"}, {"title": "A vizsgázó teljesítményének értékelése", "html": "<p>Az általános iskolából hozott tanulmányi pontok és a felvételi vizsgán elért eredmények alapján történik.</p><p>Hozott eredmények: a 7. osztály év végi és a 8. osztály félévi osztályzatai magyar nyelv és irodalom, történelem, idegen nyelv, matematika, fizika, kémia, földrajz, biológia és informatika tantárgyakból. A jeles 2 pontot, a jó 1 pontot ér; az elégtelen, elégséges és közepes 0 pont. Ha mind a 10–10 tantárgyból jeles az érdemjegy, összesen legfeljebb 40 pont szerezhető.</p>"}]} openFirst={true} />
  <DataTable heading={"A felvételi döntés alapja"} columns={["Pontforrás", "Részletek", "Pont"]} rows={[{"cells": ["Hozott pont", "Általános iskolai tanulmányi eredmény (tanulmányi pontok)", "40"]}, {"cells": ["Központi írásbeli", "Matematika és anyanyelv, 50–50 pont\n(két tanítási nyelvű informatikán 50 + 50×2 pont)", "100\n(0094: 150)"]}, {"cells": ["Szóbeli beszélgetés", "Általános beszélgetés és szakmai kérdések", "30"]}, {"cells": ["Összesen", "A hozott és a szerzett pontok összege", "170\n(0094: 220)"]}]} />
  <NewsRows rows={[{"title": "Beiratkozási információk leendő kilencedikesek számára – 2026. június 25-26.", "excerpt": "Kedves leendő Kilencedikes Diákok! Az e-Ügyintézés felületén 2025. június 17-én megnyílik majd a lehetőség a szülők részére, hogy gyermekeik adatait beküldjék iskolákba a „Beiratkozás középfokú intézménybe” (BKI) segítségével 2026. június 26-ig. A BKI folyamat...", "date": "MÁJ. 12.", "category": "Főoldali kiemelt hirek", "href": "/hirek/beiratkozasi-informaciok-leendo-kilencedikesek-szamara-2026-junius-25-26"}, {"title": "Csibetábor 2026.", "excerpt": "Kedves leendő Petrikes Diákjaink! Hamarosan eljön az első nagy találkozás ideje: A Csibetábor. Az alábbiakban szeretnénk veletek a táborral kapcsolatos információkat megosztani itt a honlapon is, korábban minden érintettnek postai úton is kiküldtük: A csibetábor...", "date": "MÁJ. 8.", "category": "Főoldali kiemelt hirek", "href": "/hirek/csibetabor-2026"}, {"title": "Végleges felvételi jegyzék a 2026/2027 tanévre", "excerpt": "Kedves Nyolcadikos Felvételizők! Elérhető az egyeztetett felvételi jegyzék, melyet a tanulók jelentkezései és az egyes iskolák rangsorai alapján az oktatási hivatal készített el. Gratulálunk a sikeres felvételihez, hamarosan találkozunk, a beiratkozáson. A sikeres...", "date": "ÁPR. 27.", "category": "Főoldali kiemelt hirek", "href": "/hirek/vegleges-felveteli-jegyzek-a-2026-2027-tanevre"}, {"title": "KÖZÉPFOKÚ FELVÉTELI: 2026. március 25-én indul a sorrendmódosítás!", "excerpt": "Elérkezett az utolsó lehetőség a finomhangolásra. 2026. március 25. és 27-e között dönthettek a tagozatok végleges sorrendjéről. Mit lehet módosítani? A módosító tanulói adatlapon: az eredetileg megadott sorrendet lehet módosítani az eredeti tanulói adatlapon is...", "date": "MÁRC. 24.", "category": "Főoldali kiemelt hirek", "href": "/hirek/kozepfoku-felveteli-2026-marcius-25-en-indul-a-sorrendmodositas"}, {"title": "Ideiglenes felvételi sorrend 2026.", "excerpt": "Kedves Felvételizők! A szóbeli felvételiket követően összesítettük a pontokat, és létrehoztuk az ideiglenes felvételi listát. Az összpontszám a hozott pontokból (40), az írásbeli felvételi pontokból (100) és a szóbeli pontokból (30) alakult ki, maximum 170 pont. A...", "date": "MÁRC. 16.", "category": "Főoldali kiemelt hirek", "href": "/hirek/ideiglenes-felveteli-lista-2026"}, {"title": "Szóbeli felvételi beosztás 2026. március", "excerpt": "Kedves Felvételizőink! Alább találjátok a 2026. március 11. napra tervezett szóbeli felvételi beosztást, melyben ctrl+F billentyűkombinációval tudtok rákeresni az oktatási azonosítótokra. A 0091, 0092 és a 0093-as kódokra jelentkezőket automatikusan behívjuk...", "date": "MÁRC. 3.", "category": "Főoldali kiemelt hirek", "href": "/hirek/szobeli-felveteli-beosztas-2026-marcius"}]} />
  <FactList heading={"Iskolai adatok"} rows={[{"label": "OM azonosító", "value": "203058"}, {"label": "Iskola neve", "value": "Budapesti Műszaki SZC Petrik Lajos Két Tanítási Nyelvű Technikum"}, {"label": "Iskola címe", "value": "1146 Budapest, Thököly út 48-54."}, {"label": "Feladatellátási hely kódja", "value": "009"}, {"label": "Technikai kód", "value": "520 413"}]} />
  <FactList heading={"Jelentkezési laphoz szükséges adatok"} rows={[{"label": "Intézménytípus", "value": "technikum"}, {"label": "0091 vegyész technikus", "value": "5+1 éves két tanítási nyelvű vegyészképzés"}, {"label": "0092 vegyész technikus", "value": "5 éves vegyészképzés"}, {"label": "0093 környezetvédelmi technikus", "value": "5 éves környezetvédelmi képzés"}, {"label": "0094 informatika és távközlés", "value": "5 éves informatikaképzés (két tanítási nyelvű)"}]} />
</Layout>

    "hono": "^4.13.17",
    "htmlparser2": "^10.0.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.11"
  }

    "better-auth": "^1.7.21",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "hono-rate-limiter": "^0.5.4",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"

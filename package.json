{
  "name": "petrik",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "bun --cwd apps/server test",
    "e2e": "playwright test",
    "db:migrate": "bun --cwd apps/server run db:migrate",
    "db:generate": "bun --cwd apps/server run db:generate",
    "db:seed": "bun --cwd apps/server run db:seed",
    "migrate:legacy": "bun --cwd apps/server run migrate:legacy",
    "media:import": "bun --cwd apps/server run media:import"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}

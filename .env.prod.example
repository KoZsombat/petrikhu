# Production values for compose.prod.yaml. Copy to .env.prod next to the compose file, or paste
# the keys into Launchpad's compose variable editor when it asks for ${VAR} placeholders.
#
# The two hostnames are Launchpad subdomains of its BASE_DOMAIN: `petrik` and `petrik-admin`
# on BASE_DOMAIN=zsombor.dev become https://petrik.zsombor.dev and https://petrik-admin.zsombor.dev.

SITE_ORIGIN=https://petrik.zsombor.dev
ADMIN_ORIGIN=https://petrik-admin.zsombor.dev

# Postgres credentials. The password is embedded in DATABASE_URL, so use URL-safe characters only
# (letters, digits, '-' and '_'); '@', ':', '/', '?' or '#' break the connection string.
POSTGRES_USER=petrik
POSTGRES_PASSWORD=
POSTGRES_DB=petrik

# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The seeded, non-deletable admin account. Only used on the first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
